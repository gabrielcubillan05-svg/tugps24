---
import type { Session, Section } from '../lib/auth';
import { SECTION_LABELS, SECTION_PATHS, ROLE_LABELS, sectionsFor } from '../lib/auth';

export interface Props {
  title: string;
  active: Section | null;
  session: Session;
}

const { title, active, session } = Astro.props;
const sections = sectionsFor(session);

// Agrupación puramente visual del nav (no cambia permisos: sectionsFor ya decide qué ve cada
// quien; aquí solo se organiza la presentación en menús por categoría, estilo Hotelia).
const ICONS: Record<string, string> = {
  home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>',
  wrench: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/></svg>',
  shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  briefcase: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  chat: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
};

const NAV_GROUPS: { label: string; icon: keyof typeof ICONS; sections: Section[] }[] = [
  { label: 'Principal', icon: 'home', sections: ['novedades', 'reportes', 'estadisticas'] },
  { label: 'Operación', icon: 'wrench', sections: ['tareas', 'planillas-vehiculo', 'esquemas-apagado'] },
  { label: 'Seguridad', icon: 'shield', sections: ['cuadrantes', 'casos-importantes', 'suspensiones'] },
  { label: 'Comercial', icon: 'briefcase', sections: ['crm', 'cotizaciones', 'seguimiento-masivos', 'conversaciones-whatsapp', 'cobros'] },
  { label: 'Administración', icon: 'settings', sections: ['auditoria', 'usuarios', 'solicitudes-administrativas', 'pagos-internos', 'agentes-ia'] },
  { label: 'Recursos Humanos', icon: 'users', sections: ['rrhh'] },
  { label: 'Chat', icon: 'chat', sections: ['chat'] },
];

const navGroups = NAV_GROUPS.map((g) => ({ ...g, items: g.sections.filter((s) => sections.includes(s)) })).filter(
  (g) => g.items.length > 0
);
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — TuGPS24</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/interno-manifest.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TuGPS24" />
    <link rel="apple-touch-icon" href="/img/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script src="/js/theme-toggle.js" is:inline></script>
    <script src="/js/interno-sw-register.js" defer></script>
    <style is:global>
      :root {
        --ink-900: #0a0a0a;
        --ink-800: #151412;
        --ink-700: #1e1c19;
        --line: #332e28;
        --paper: #f2ede2;
        --paper-dim: #c9c2b2;
        --slate: #948d80;
        --amber: #ff7a1a;
        --amber-dim: #c85e12;
        --teal: #ffb066;
        --teal-bright: #ffab5c;
        --danger: #e0563f;
        --ok: #6fce8f;
        --glow-1: #ff7a1a29;
        --glow-2: #ffb06624;
        --ring-1: #ff7a1a8c;
        --ring-2: #ffab5c80;
        --shadow-soft: #00000059;
        --shadow-strong: #000000b3;
        --btn-shadow: #ff7a1a73;
        --grid-line: #ffffff0d;
        --radius: 14px;
        --display: "Poppins", system-ui, sans-serif;
        --body: "Poppins", system-ui, sans-serif;
        --mono: "IBM Plex Mono", monospace;
      }
      html[data-theme="light"] {
        --ink-900: #faf7f2;
        --ink-800: #ffffff;
        --ink-700: #f1ece1;
        --line: #e4dccb;
        --paper: #1c1712;
        --paper-dim: #5b5347;
        --slate: #8a8072;
        --amber: #e8630a;
        --amber-dim: #c85e12;
        --teal: #d9640f;
        --teal-bright: #c85e12;
        --danger: #c9432e;
        --ok: #2f8a4f;
        --glow-1: #e8630a1a;
        --glow-2: #e8630a14;
        --ring-1: #e8630a66;
        --ring-2: #c85e1259;
        --shadow-soft: #1e140a14;
        --shadow-strong: #1e140a29;
        --btn-shadow: #e8630a4d;
        --grid-line: #0000000b;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { overflow-x: hidden; }
      body {
        background: var(--ink-900);
        color: var(--paper);
        font-family: var(--body);
        min-height: 100vh;
        line-height: 1.5;
        transition: background 0.25s, color 0.25s;
        overflow-x: hidden;
      }
      h1, h2, h3, .btn, .nav-pill, .brand h1 { font-family: var(--display); }
      a { color: inherit; }
      .theme-toggle {
        border: 1px solid var(--line);
        cursor: pointer;
        width: 38px;
        height: 38px;
        color: var(--paper);
        background: none;
        border-radius: 50%;
        flex-shrink: 0;
        justify-content: center;
        align-items: center;
        transition: border-color 0.2s, transform 0.2s;
        display: flex;
      }
      .theme-toggle:hover { border-color: var(--teal-bright); transform: rotate(12deg); }
      .theme-toggle svg { width: 17px; height: 17px; }
      .theme-toggle .sun, html[data-theme="light"] .theme-toggle .moon { display: none; }
      html[data-theme="light"] .theme-toggle .sun { display: block; }

      .wrap { max-width: 1800px; margin: 0 auto; padding: 24px 28px 80px; }

      .login-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
      .login-box {
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 36px;
        width: 100%;
        max-width: 360px;
      }
      .login-box h1 { font-size: 20px; margin-bottom: 8px; }
      .login-box p { color: var(--slate); font-size: 13.5px; margin-bottom: 20px; }

      .field { margin-bottom: 16px; }
      .field label { display: block; color: var(--slate); font-size: 12.5px; margin-bottom: 6px; }
      input, select, textarea, button { font-family: inherit; font-size: 14.5px; }
      input, select, textarea {
        width: 100%;
        background: var(--ink-900);
        border: 1px solid var(--line);
        color: var(--paper);
        border-radius: 8px;
        padding: 10px 12px;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--amber);
        box-shadow: 0 0 0 3px var(--glow-1);
      }
      textarea { resize: vertical; min-height: 70px; }
      .btn {
        background: var(--amber);
        color: #1a0f00;
        border: none;
        cursor: pointer;
        border-radius: 999px;
        padding: 11px 20px;
        font-weight: 600;
        box-shadow: 0 4px 14px var(--btn-shadow);
        transition: transform 0.15s, box-shadow 0.15s;
      }
      .btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px var(--btn-shadow); }
      .btn:active:not(:disabled) { transform: translateY(0); }
      .btn:disabled { opacity: 0.6; cursor: default; box-shadow: none; }
      .btn-ghost {
        background: none;
        border: 1px solid var(--line);
        color: var(--paper);
        cursor: pointer;
        border-radius: 999px;
        padding: 9px 16px;
        font-size: 13px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
      }
      .btn-small { padding: 6px 14px; font-size: 12.5px; border-radius: 999px; cursor: pointer; }
      .btn-done { background: #2f8a4f22; color: var(--ok); border: 1px solid #2f8a4f55; }
      .btn-delete { background: #e0563f22; color: var(--danger); border: 1px solid #e0563f55; }
      .error-msg { color: var(--danger); font-size: 13px; margin-bottom: 14px; }
      .success-msg { color: var(--ok); font-size: 13px; margin-bottom: 14px; }

      header.panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 14px;
        flex-wrap: wrap;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
      }
      .brand { display: flex; flex-direction: row; align-items: center; gap: 10px; }
      .brand-logo {
        height: 26px;
        width: auto;
        display: block;
        background: #fff;
        padding: 4px 8px;
        border-radius: 8px;
      }
      .brand h1 { font-size: 19px; }
      .brand h1 span { color: var(--slate); font-weight: 400; }
      .user-chip { color: var(--slate); font-size: 12px; }
      .top-nav { display: flex; gap: 6px; flex-wrap: wrap; }
      .nav-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid var(--line);
        color: var(--paper-dim);
        border-radius: 999px;
        padding: 7px 14px;
        font-size: 13px;
        text-decoration: none;
        background: none;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s, box-shadow 0.15s;
      }
      .nav-pill svg { width: 15px; height: 15px; flex-shrink: 0; }
      .nav-pill:hover { border-color: var(--amber-dim); color: var(--paper); }
      .nav-pill.active { background: var(--amber); color: #1a0f00; border-color: var(--amber); font-weight: 600; box-shadow: 0 3px 10px var(--btn-shadow); }
      .nav-chevron { width: 11px !important; height: 11px !important; transition: transform 0.15s; }
      .nav-group { position: relative; }
      .nav-group.open .nav-chevron { transform: rotate(180deg); }
      .nav-dropdown {
        display: none;
        flex-direction: column;
        gap: 3px;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 8px;
        min-width: 220px;
        max-width: calc(100vw - 32px);
        box-shadow: 0 16px 34px var(--shadow-soft);
        z-index: 40;
      }
      .nav-group.open .nav-dropdown { display: flex; }
      .nav-dropdown a {
        padding: 8px 10px;
        border-radius: 8px;
        color: var(--paper-dim);
        text-decoration: none;
        font-size: 13.5px;
        transition: background 0.15s, color 0.15s;
      }
      .nav-dropdown a:hover { background: var(--ink-900); color: var(--paper); }
      .nav-dropdown a.active { background: var(--glow-1); color: var(--amber); font-weight: 600; }
      .head-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

      .panel-card {
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 22px;
        margin-bottom: 24px;
        box-shadow: 0 1px 2px var(--shadow-soft), 0 10px 26px -14px var(--shadow-soft);
        animation: panel-enter 0.35s ease both;
      }
      @keyframes panel-enter {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .panel-card h2 { font-size: 15px; margin-bottom: 16px; }
      .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      .form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
      .form-grid.cols-2 { grid-template-columns: 1fr 1fr; }
      .form-grid.cols-4 { grid-template-columns: 1fr 1fr 1fr 1fr; }
      .form-grid .field-note, .form-grid .field-full { grid-column: 1 / -1; }
      .filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; align-items: center; }
      .filters input, .filters select { width: auto; min-width: 160px; flex: 1; }
      .filters label.checkbox { display: flex; align-items: center; gap: 6px; color: var(--paper-dim); font-size: 13px; white-space: nowrap; }
      .filters label.checkbox input { width: auto; }
      .tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 18px;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--line);
        padding-bottom: 12px;
      }
      .tab-btn {
        background: none;
        border: 1px solid var(--line);
        color: var(--paper-dim);
        cursor: pointer;
        border-radius: 999px;
        padding: 8px 16px;
        font-size: 13.5px;
      }
      .tab-btn.active { background: var(--amber); color: #1a0f00; border-color: var(--amber); font-weight: 600; box-shadow: 0 3px 10px var(--btn-shadow); }

      .reports-list, .list-col { display: flex; flex-direction: column; gap: 10px; }
      .report-item, .list-item {
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 14px 16px;
        box-shadow: 0 1px 2px var(--shadow-soft);
        transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
      }
      .report-item:hover, .list-item:hover { border-color: var(--amber-dim); transform: translateY(-1px); box-shadow: 0 8px 18px var(--shadow-soft); }
      .list-item.pending, .list-item.overdue { border-color: var(--danger); background: #e0563f14; }
      .report-item .report-top, .list-item .item-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
        flex-wrap: wrap;
        align-items: center;
      }
      .report-item .plate, .list-item .title { font-weight: 700; }
      .report-item .badge, .list-item .badge {
        background: var(--glow-1);
        color: var(--teal-bright);
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 11.5px;
      }
      .list-item .badge.status.ok { background: #2f8a4f33; color: var(--ok); }
      .list-item .badge.status.danger { background: var(--danger); color: #fff; }
      .report-item .meta, .list-item .meta { color: var(--slate); font-size: 12px; }
      .report-item .meta { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
      .report-item .meta .author { font-weight: 600; }
      .report-item .note, .list-item .note { color: var(--paper-dim); font-size: 14px; margin-bottom: 8px; }
      .report-images { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
      .report-images img {
        width: 72px; height: 72px; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); display: block;
      }
      .item-actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
      .image-preview { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
      .image-preview .thumb { position: relative; width: 64px; height: 64px; }
      .image-preview .thumb img {
        width: 100%; height: 100%; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); display: block;
      }
      .image-preview .thumb button {
        position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; border-radius: 50%;
        background: var(--danger); color: #fff; border: none; cursor: pointer; font-size: 12px; line-height: 1; padding: 0;
      }
      .empty { color: var(--slate); font-size: 14px; padding: 20px 0; text-align: center; }
      .stats-row { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
      .stat-box {
        background: var(--ink-800); border: 1px solid var(--line); border-radius: 10px; padding: 14px; text-align: center;
        box-shadow: 0 1px 2px var(--shadow-soft);
      }
      .stat-box .n { font-size: 22px; font-weight: 700; color: var(--amber); display: block; }
      .stat-box .l { font-size: 10.5px; color: var(--slate); }
      .stat-box.overdue .n { color: var(--danger); }

      .modal-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.55); display: flex; align-items: center; justify-content: center;
        padding: 20px; z-index: 50;
      }
      .modal-box {
        background: var(--ink-800); border: 1px solid var(--line); border-radius: 14px; padding: 26px; width: 100%; max-width: 360px;
      }
      .modal-box h2 { font-size: 17px; margin-bottom: 16px; }

      .nav-badge, .bell-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 999px;
        background: var(--danger);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        margin-left: 6px;
      }
      .bell-wrap { position: relative; }
      .bell-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        margin-left: 0;
      }
      .notif-dropdown {
        position: fixed;
        top: 60px;
        right: 16px;
        width: 320px;
        max-width: calc(100vw - 32px);
        max-height: 420px;
        overflow-y: auto;
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        z-index: 60;
        padding: 10px;
      }
      .notif-dropdown h3 { font-size: 13px; margin: 4px 6px 8px; display:flex; justify-content:space-between; align-items:center; }
      .notif-item {
        display: block;
        padding: 9px 8px;
        border-radius: 8px;
        font-size: 13px;
        color: var(--paper);
        text-decoration: none;
      }
      .notif-item:hover { background: var(--ink-900); }
      .notif-item.unread { font-weight: 600; }
      .notif-item.urgent { background: #e0563f22; border: 1px solid var(--danger); color: var(--danger); }
      .notif-item.urgent:hover { background: #e0563f38; }
      .notif-item .notif-time { display: block; color: var(--slate); font-size: 11px; font-weight: 400; margin-top: 2px; }
      .notif-empty { color: var(--slate); font-size: 13px; padding: 14px 8px; text-align: center; }

      @media (max-width: 900px) {
        .stats-row { grid-template-columns: repeat(3, 1fr); }
      }
      @media (max-width: 700px) {
        .form-grid, .form-grid.cols-2, .form-grid.cols-4 { grid-template-columns: 1fr; }
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        header.panel-head { flex-direction: column; align-items: stretch; }
        .top-nav { width: 100%; }
        .head-actions { width: 100%; justify-content: space-between; }
        .wrap { padding: 16px 14px 60px; }
        .panel-card { padding: 16px; }
        /* iOS hace zoom automático al enfocar un input con font-size menor a 16px */
        input, select, textarea { font-size: 16px; }
      }
      @media (max-width: 480px) {
        .stats-row { grid-template-columns: repeat(2, 1fr); }
        .brand h1 { font-size: 16px; }
      }

      .gabot-widget { position: fixed; right: 22px; bottom: 22px; z-index: 500; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
      .gabot-bubble {
        width: 54px; height: 54px; border-radius: 50%;
        background: var(--teal-bright); color: #06231f;
        border: none; font-size: 24px; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 6px 18px rgba(0,0,0,0.35);
        position: relative;
        padding: 0; overflow: hidden;
      }
      .gabot-bubble img { width: 100%; height: 100%; object-fit: cover; }
      .gabot-avatar { width: 22px; height: 22px; object-fit: contain; }
      .gabot-bubble.pulse { animation: gabot-pulse 1.4s ease-in-out infinite; }
      @keyframes gabot-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.08); } }
      .gabot-badge {
        position: absolute; top: -4px; right: -4px;
        background: var(--danger); color: #fff; font-size: 11px; font-weight: 700;
        min-width: 20px; height: 20px; border-radius: 10px; padding: 0 5px;
        display: flex; align-items: center; justify-content: center;
      }
      .gabot-panel {
        width: min(340px, calc(100vw - 44px)); height: min(440px, calc(100vh - 140px));
        background: var(--ink-800); border: 1px solid var(--line); border-radius: 12px;
        display: flex; flex-direction: column; overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
      }
      .gabot-panel-header {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 12px; font-weight: 700; font-size: 13.5px;
        background: var(--ink-900); border-bottom: 1px solid var(--line);
      }
      .gabot-panel-header span { flex: 1; }
      .gabot-panel-header button { background: none; border: none; color: var(--paper); font-size: 18px; cursor: pointer; line-height: 1; }
      .gabot-messages { flex: 1; overflow-y: auto; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
      .gabot-msg { max-width: 88%; padding: 7px 10px; border-radius: 10px; font-size: 12.5px; white-space: pre-wrap; }
      .gabot-msg.bot { align-self: flex-start; background: var(--ink-700); }
      .gabot-msg.mine { align-self: flex-end; background: var(--teal-bright); color: #06231f; }
      .gabot-msg .gabot-msg-time { display: block; font-size: 10px; opacity: 0.65; margin-top: 3px; }
      .gabot-msg.gabot-typing { font-style: italic; opacity: 0.7; animation: gabot-typing-pulse 1.4s ease-in-out infinite; }
      @keyframes gabot-typing-pulse { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.85; } }
      .gabot-form { display: flex; gap: 6px; padding: 8px; border-top: 1px solid var(--line); }
      .gabot-form input { flex: 1; font-size: 12.5px; padding: 7px 9px; }
      .gabot-mic {
        border: 1px solid var(--line); background: var(--ink-700); border-radius: 8px;
        width: 32px; flex-shrink: 0; cursor: pointer; font-size: 14px; line-height: 1;
      }
      .gabot-mic.recording { background: var(--danger); color: #fff; animation: gabot-pulse 1s ease-in-out infinite; }
    </style>
  </head>
  <body data-user-id={session.userId}>
    <div class="wrap">
      <header class="panel-head">
        <div class="brand">
          <img src="/img/img01.png" alt="TuGPS24" class="brand-logo" />
          <div>
            <h1>Interno</h1>
            <div class="user-chip">{session.username} · {ROLE_LABELS[session.role]}</div>
          </div>
        </div>
        <nav class="top-nav">
          {navGroups.map((g) => {
            if (g.items.length === 1) {
              const s = g.items[0];
              return (
                <a href={SECTION_PATHS[s]} class={`nav-pill ${active === s ? 'active' : ''}`}>
                  <Fragment set:html={ICONS[g.icon]} />
                  {SECTION_LABELS[s]}
                  {s === 'chat' && <span class="nav-badge" id="chatNavBadge" style="display:none;"></span>}
                </a>
              );
            }
            const isActive = active !== null && g.items.includes(active);
            return (
              <div class="nav-group">
                <button type="button" class={`nav-pill nav-group-btn ${isActive ? 'active' : ''}`} data-nav-group>
                  <Fragment set:html={ICONS[g.icon]} />
                  {g.label}
                  <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                </button>
                <div class="nav-dropdown">
                  {g.items.map((s) => (
                    <a href={SECTION_PATHS[s]} class={active === s ? 'active' : ''}>{SECTION_LABELS[s]}</a>
                  ))}
                </div>
              </div>
            );
          })}
        </nav>
        <div class="head-actions">
          <div class="bell-wrap">
            <button class="theme-toggle" id="notifBell" type="button" title="Notificaciones" aria-label="Notificaciones">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </button>
            <span class="bell-badge" id="bellBadge" style="display:none;"></span>
            <div class="notif-dropdown" id="notifDropdown" style="display:none;">
              <h3>
                <span>Notificaciones</span>
                <button class="btn-small" id="markAllReadBtn" type="button" style="padding:3px 10px; font-size:11px;">Marcar leídas</button>
              </h3>
              <div id="notifList"><div class="notif-empty">Cargando...</div></div>
            </div>
          </div>
          <button class="theme-toggle" id="themeToggle" type="button" title="Cambiar tema" aria-label="Cambiar tema">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <button class="btn-ghost" id="changePasswordBtn" type="button">Cambiar clave</button>
          <form method="POST" action="/api/auth/logout">
            <button class="btn-ghost" type="submit">Cerrar sesión</button>
          </form>
        </div>
      </header>

      <slot />
    </div>

    <div class="modal-overlay" id="pwModalOverlay" style="display:none;">
      <div class="modal-box">
        <h2>Cambiar contraseña</h2>
        <form id="pwForm" autocomplete="on">
          <div class="field">
            <label for="pwCurrent">Contraseña actual</label>
            <input id="pwCurrent" name="current-password" type="password" autocomplete="current-password" />
          </div>
          <div class="field">
            <label for="pwNew">Nueva contraseña (mín. 8 caracteres)</label>
            <input id="pwNew" name="new-password" type="password" autocomplete="new-password" />
          </div>
          <p id="pwError" class="error-msg" style="display:none;"></p>
          <p id="pwSuccess" class="success-msg" style="display:none;">Contraseña actualizada.</p>
          <div style="display:flex; gap:10px; margin-top:6px;">
            <button class="btn" id="pwSubmit" type="button">Guardar</button>
            <button class="btn-ghost" id="pwCancel" type="button">Cancelar</button>
          </div>
        </form>
      </div>
    </div>

    <div class="gabot-widget" id="gabotWidget" style="display:none;">
      <div class="gabot-panel" id="gabotPanel" style="display:none;">
        <div class="gabot-panel-header">
          <img src="/img/gpsito.png" alt="" class="gabot-avatar" />
          <span>GPSITO</span>
          <button type="button" id="gabotClose" aria-label="Cerrar">×</button>
        </div>
        <div class="gabot-messages" id="gabotMessages"><div class="empty">Cargando...</div></div>
        <form class="gabot-form" id="gabotForm">
          <button class="gabot-mic" type="button" id="gabotMic" title="Grabar un audio" aria-label="Grabar un audio">🎤</button>
          <input id="gabotInput" type="text" placeholder="Escríbele a GPSITO..." autocomplete="off" />
          <button class="btn-small" type="submit">Enviar</button>
        </form>
      </div>
      <button type="button" class="gabot-bubble" id="gabotBubble" title="GPSITO, tu asistente de pendientes">
        <img src="/img/gpsito.png" alt="GPSITO" />
        <span class="gabot-badge" id="gabotBadge" style="display:none;"></span>
      </button>
    </div>

    <script src="/js/interno-shell.js" defer></script>
    <script src="/js/interno-notifications.js" defer></script>
    <script src="/js/interno-gabot-widget.js" defer></script>
  </body>
</html>
