---
// Asistente flotante de Andrés en el sitio público — atiende a quien entra buscando info de
// la empresa, y si muestra interés real, queda como lead de verdad en el CRM (source: web-chat).
---

<div class="web-chat-widget" id="webChatWidget">
  <div class="web-chat-panel" id="webChatPanel">
    <div class="web-chat-header">
      <div class="web-chat-avatar">A</div>
      <div class="web-chat-header-text">
        <span class="web-chat-name">Andrés</span>
        <span class="web-chat-sub">Asesor TuGPS24</span>
      </div>
      <button type="button" id="webChatMinimize" aria-label="Minimizar">–</button>
    </div>
    <div class="web-chat-messages" id="webChatMessages"></div>
    <form class="web-chat-gate" id="webChatGateForm">
      <input id="webChatGateName" type="text" placeholder="Tu nombre" required autocomplete="name" />
      <input id="webChatGatePhone" type="tel" placeholder="Tu WhatsApp (ej: 3001234567)" required autocomplete="tel" />
      <button type="submit">Empezar a chatear</button>
      <p class="web-chat-gate-hint">Para atenderte mejor, solo necesitamos tu nombre y tu WhatsApp.</p>
    </form>
    <form class="web-chat-form" id="webChatForm" style="display:none;">
      <input id="webChatInput" type="text" placeholder="Escribe tu mensaje..." autocomplete="off" />
      <button type="submit" aria-label="Enviar">➤</button>
    </form>
  </div>
  <button type="button" class="web-chat-bubble" id="webChatBubble" aria-label="Chatear con Andrés">
    💬
  </button>
</div>

<style>
  .web-chat-widget {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 900;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    font-family: var(--body);
  }
  .web-chat-bubble {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--amber);
    color: #1a0f00;
    border: none;
    font-size: 24px;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 18px var(--shadow-soft);
  }
  .web-chat-widget.minimized .web-chat-bubble { display: flex; }
  .web-chat-widget.minimized .web-chat-panel { display: none; }
  .web-chat-panel {
    width: min(340px, calc(100vw - 36px));
    height: min(460px, calc(100vh - 120px));
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 12px 34px var(--shadow-strong);
  }
  .web-chat-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: var(--ink-900);
    border-bottom: 1px solid var(--line);
  }
  .web-chat-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--amber);
    color: #1a0f00;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }
  .web-chat-header-text { flex: 1; display: flex; flex-direction: column; line-height: 1.25; }
  .web-chat-name { font-weight: 700; font-size: 13.5px; color: var(--paper); }
  .web-chat-sub { font-size: 11px; color: var(--slate); }
  .web-chat-header button {
    background: none;
    border: none;
    color: var(--paper);
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
  }
  .web-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .web-chat-msg {
    max-width: 85%;
    padding: 8px 11px;
    border-radius: 10px;
    font-size: 13px;
    white-space: pre-wrap;
    line-height: 1.4;
  }
  .web-chat-msg.bot { align-self: flex-start; background: var(--ink-700); color: var(--paper); }
  .web-chat-msg.mine { align-self: flex-end; background: var(--amber); color: #1a0f00; }
  .web-chat-msg.typing { font-style: italic; opacity: 0.7; }
  .web-chat-gate {
    padding: 12px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .web-chat-gate input {
    background: var(--ink-900);
    border: 1px solid var(--line);
    color: var(--paper);
    border-radius: 8px;
    padding: 9px 11px;
    font-size: 13.5px;
    font-family: inherit;
  }
  .web-chat-gate button {
    background: var(--amber);
    color: #1a0f00;
    border: none;
    border-radius: 999px;
    padding: 9px;
    font-weight: 600;
    cursor: pointer;
    font-size: 13.5px;
  }
  .web-chat-gate-hint { font-size: 11px; color: var(--slate); margin: 0; }
  .web-chat-form {
    display: flex;
    gap: 8px;
    padding: 10px;
    border-top: 1px solid var(--line);
  }
  .web-chat-form input {
    flex: 1;
    background: var(--ink-900);
    border: 1px solid var(--line);
    color: var(--paper);
    border-radius: 999px;
    padding: 9px 14px;
    font-size: 13.5px;
    font-family: inherit;
  }
  .web-chat-form button {
    width: 38px;
    flex-shrink: 0;
    background: var(--amber);
    color: #1a0f00;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    font-size: 15px;
  }
  @media (max-width: 480px) {
    .web-chat-widget { right: 10px; bottom: 10px; }
    .web-chat-panel { width: calc(100vw - 20px); height: min(70vh, 520px); }
  }
</style>

<script src="/js/web-chat-widget.js" defer></script>
