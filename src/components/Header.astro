  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/tugps24',
    path: 'M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.2-1.5 1.6-1.5h1.7V3.7C15.9 3.6 15 3.5 13.9 3.5c-2.3 0-3.9 1.4-3.9 4v2.4H7.3V13H10v8h3.5z',
  },
  {
    name: 'TikTok',
    href: 'https://www.tiktok.com/@tugps24',
    path: 'M16.6 2h-3.2v13.4a2.7 2.7 0 1 1-2.7-2.7c.2 0 .5 0 .7.1V9.5a5.9 5.9 0 1 0 5.2 5.9V8.6a7.6 7.6 0 0 0 4.4 1.4V6.8a4.3 4.3 0 0 1-4.4-4.3z',
  },
  {
    name: 'X',
