---
const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#cobertura', label: 'Sucursales' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#promocion', label: 'Promoción' },
  { href: '#contacto', label: 'Contacto' },
];

const whatsappUrl =
  'https://wa.me/573116105725?text=Hola%2C%20quiero%20cotizar%20la%20instalaci%C3%B3n%20de%20un%20GPS';

