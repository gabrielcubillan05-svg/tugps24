---
const videos = [
  { src: '/videos/central-monitoreo.mp4', poster: '/img/central/central-video-poster.jpg', label: 'Central de monitoreo — turno en vivo' },
  { src: '/videos/central/central-video-02.mp4', poster: '/img/central/central-video-02-poster.jpg', label: 'Así funciona TuGPS24' },
  { src: '/videos/central/central-video-03.mp4', poster: '/img/central/central-video-03-poster.jpg', label: '¿Por qué confiar en TuGPS24?' },
  { src: '/videos/central/central-video-05.mp4', poster: '/img/central/central-video-05-poster.jpg', label: '¿Qué hace una operadora de alarmas?' },
];
---

<section class="section alt-bg" id="central-monitoreo">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">En vivo</p>
      <h2>Así es nuestra central de monitoreo 24/7.</h2>
      <p>
        Operadores reales, turno tras turno, revisando cada alerta de tu vehículo — no una
        aplicación sin nadie del otro lado.
      </p>
    </div>
    <div class="central-media-grid reveal">
      <img src="/img/central/central-1.jpg" alt="Central de monitoreo TuGPS24 — turno en vivo" loading="lazy" />
      <img src="/img/central/central-2.jpg" alt="Operadores en la central de monitoreo TuGPS24" loading="lazy" />
      {videos.map((v) => (
        <button class="video-card" type="button" data-video-src={v.src} aria-label={`Reproducir: ${v.label}`}>
          <img src={v.poster} alt="" loading="lazy" />
          <span class="video-play-icon">▶</span>
        </button>
      ))}
    </div>
  </div>
</section>
