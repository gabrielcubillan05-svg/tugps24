---
const cities = ['Riohacha', 'Valledupar', 'Santa Marta', 'Maicao', 'Soledad', 'Barranquilla', 'Bucaramanga', 'Medellín', 'Montería'];

const emergencyLines = [
  '316 383 4278',
  '317 517 4475',
  '317 641 0644',
  '310 626 5332',
  '302 406 9163',
  '310 635 2171',
  '310 624 7861',
];
---

<section class="section" id="contacto">
  <div class="wrap contact-wrap">
    <div class="contact-info reveal">
      <p class="eyebrow">Contacto</p>
      <h2>Cotiza tu instalación hoy mismo.</h2>
      <p>
        Escríbenos por WhatsApp o llena el formulario — un asesor de la sucursal más cercana te
        responde el mismo día.
      </p>
      <div class="contact-channel">
        <span class="ico">W</span>
        <div><b>WhatsApp</b><span>Respuesta inmediata en horario de oficina</span></div>
      </div>
      <div class="contact-channel">
        <span class="ico">☎</span>
        <div>
          <b>Línea de central 24/7</b>
          <span>Para reportar un robo o comunicarte con la central</span>
          <div class="emergency-lines">
            {emergencyLines.map((n) => (
              <a href={`tel:+57${n.replace(/\s/g, '')}`} class="emergency-line">{n}</a>
            ))}
          </div>
        </div>
      </div>
      <div class="contact-channel">
        <span class="ico">📍</span>
        <div><b>9 sucursales</b><span>{cities.join(', ')}</span></div>
      </div>
    </div>
    <form class="contact-form reveal" id="contactForm">
      <div class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="field">
        <label for="nombre">Nombre completo</label>
        <input id="nombre" type="text" placeholder="Escribe tu nombre" required />
      </div>
      <div class="field">
        <label for="ciudad">Sucursal más cercana</label>
        <select id="ciudad">
          {cities.map((c) => <option>{c}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="telefono">Número de WhatsApp</label>
        <input id="telefono" type="tel" placeholder="+57 300 000 0000" required />
      </div>
      <button class="btn btn-primary" type="submit">Solicitar cotización</button>
    </form>
  </div>
</section>
