---

<section class="section alt-bg" id="cobertura">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Sucursales</p>
      <h2>Presencia directa en el Caribe y el interior de Colombia.</h2>
      <p>
        Nueve sucursales propias, cada una con técnicos e infraestructura de instalación local —
        no dependemos de terceros para atenderte.
      </p>
    </div>
    <div class="branch-grid reveal">
      {branches.map((b) => (
        <div class="branch-card">
          <div class="branch-photo-carousel">
            {b.photos.map((src, i) => (
              <img
                class={`branch-photo${i === 0 ? ' active' : ''}`}
                src={src}
                alt={i === 0 ? b.alt : `${b.alt} — interior`}
                loading="lazy"
              />
            ))}
            {b.photos.length > 1 && (
              <>
                <button class="carousel-arrow prev" type="button" aria-label="Foto anterior">‹</button>
                <button class="carousel-arrow next" type="button" aria-label="Foto siguiente">›</button>
                <div class="carousel-dots">
                  {b.photos.map((_, i) => (
                    <span class={i === 0 ? 'active' : ''}></span>
                  ))}
                </div>
              </>
            )}
          </div>
          <div class="branch-body">
            <div class="city">{b.city}</div>
            <div class="addr" set:html={b.addr} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
