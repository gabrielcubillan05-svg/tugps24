---
const videos = Array.from({ length: 15 }, (_, i) => {
  const num = String(i + 1).padStart(2, '0');
  return {
    src: `/videos/recuperaciones/recuperacion-video-${num}.mp4`,
    poster: `/img/recuperaciones-videos/recuperacion-video-${num}.jpg`,
    alt: `Video de recuperación TuGPS24 — caso ${num}`,
  };
});
---

<section class="section alt-bg" id="videos-recuperaciones">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">En video</p>
      <h2>Las recuperaciones más impactantes, grabadas en el momento.</h2>
      <p>
        Así se ven nuestras recuperaciones en tiempo real — coordinadas con las autoridades,
        vehículo por vehículo.
      </p>
    </div>
    <div class="recovery-gallery reveal">
      <button class="recovery-arrow prev" type="button" aria-label="Ver videos anteriores">‹</button>
      <div class="recovery-track">
        {videos.map((v) => (
          <video
            class="recovery-card"
            src={v.src}
            poster={v.poster}
            width="170"
            height="212"
            controls
            preload="none"
            aria-label={v.alt}
          ></video>
        ))}
      </div>
      <button class="recovery-arrow next" type="button" aria-label="Ver videos siguientes">›</button>
    </div>
  </div>
</section>
