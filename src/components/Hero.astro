<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">Central de monitoreo activa ahora</p>
      <h1>Tu vehículo, <em>vigilado en tiempo real</em>, las 24 horas del año.</h1>
      <p class="lede">
        Rastreo satelital, bloqueo remoto de motor y una central con más de 40 operadores que
        responde de verdad — no un algoritmo. Nos enfocamos en un servicio cercano contigo y
        coordinamos cada operativo directamente con las autoridades.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={whatsappUrl} target="_blank" rel="noopener">Cotizar instalación</a>
        <a class="btn btn-ghost" href="#cobertura">Ver sucursales</a>
      </div>
      <div class="hero-proof">
        <div><b data-count="1650" data-suffix="+">0</b><span>Vehículos recuperados</span></div>
        <div><b>24/7</b><span>Central de monitoreo</span></div>
        <div><b data-count="40" data-suffix="+">0</b><span>Operadores en turno</span></div>
        <div><b data-count="10">0</b><span>Años operando</span></div>
      </div>
    </div>
    <div class="console">
      <div class="console-head">
        <span>CENTRAL_MONITOREO — SUCURSAL_RIOHACHA</span>
        <span class="live"><span class="live-dot"></span>EN VIVO</span>
      </div>
      <div class="radar-map">
        <svg viewBox="0 0 520 300" preserveAspectRatio="xMidYMin slice" xmlns="http://www.w3.org/2000/svg">
          <path class="co-outline" d={coOutline}></path>
          {nodes.map((n) => (
            <>
              <circle class={`node-ping${n.alt ? ' alt' : ''}`} cx={n.cx} cy={n.cy} r="4.5" style={`animation-delay:${n.delay}`}></circle>
              <circle class={`node${n.alt ? ' alt' : ''}`} cx={n.cx} cy={n.cy} r="4.5"></circle>
            </>
          ))}
          {nodes.map((n) => (
            <text class="node-label" x={n.lx} y={n.ly}>{n.label}</text>
          ))}
        </svg>
      </div>
      <ul class="console-log">
        {logs.map((log) => (
          <li><time>{log.time}</time><span class="ok">{log.text}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>
