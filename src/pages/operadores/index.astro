---
export const prerender = false;

import { isAuthorized, AUTH_COOKIE } from '../../lib/internalAuth';

const authed = isAuthorized(Astro.cookies.get(AUTH_COOKIE)?.value);
const loginError = Astro.url.searchParams.get('error') === '1';

const CATEGORIES = ['Notificación', 'Salida de geocerca', 'Finalizado', 'Alarma', 'Novedad', 'Otro'];
const BRANCHES = ['Riohacha', 'Valledupar', 'Santa Marta', 'Maicao', 'Soledad', 'Barranquilla', 'Bucaramanga', 'Medellín', 'Montería'];
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel interno — TuGPS24</title>
    <style>
      :root {
        --ink-900: #0a0a0a;
        --ink-800: #151412;
        --ink-700: #1e1c19;
        --line: #332e28;
        --paper: #f2ede2;
        --paper-dim: #c9c2b2;
        --slate: #948d80;
        --amber: #ff7a1a;
        --teal-bright: #ffab5c;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--ink-900);
        color: var(--paper);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        min-height: 100vh;
        line-height: 1.5;
      }
      .wrap { max-width: 960px; margin: 0 auto; padding: 32px 20px 80px; }
      a { color: inherit; }
      .login-wrap {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .login-box {
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 36px;
        width: 100%;
        max-width: 360px;
      }
      .login-box h1 { font-size: 20px; margin-bottom: 8px; }
      .login-box p { color: var(--slate); font-size: 13.5px; margin-bottom: 20px; }
      .field { margin-bottom: 16px; }
      .field label { display: block; color: var(--slate); font-size: 12.5px; margin-bottom: 6px; }
      input, select, textarea, button {
        font-family: inherit;
        font-size: 14.5px;
      }
      input, select, textarea {
        width: 100%;
        background: var(--ink-900);
        border: 1px solid var(--line);
        color: var(--paper);
        border-radius: 8px;
        padding: 10px 12px;
      }
      textarea { resize: vertical; min-height: 70px; }
      .btn {
        background: var(--amber);
        color: #1a0f00;
        border: none;
        cursor: pointer;
        border-radius: 999px;
        padding: 11px 20px;
        font-weight: 600;
      }
      .btn-ghost {
        background: none;
        border: 1px solid var(--line);
        color: var(--paper);
        cursor: pointer;
        border-radius: 999px;
        padding: 9px 16px;
        font-size: 13px;
      }
      .error-msg { color: #e0563f; font-size: 13px; margin-bottom: 14px; }
      header.panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
        gap: 12px;
        flex-wrap: wrap;
      }
      header.panel-head h1 { font-size: 20px; }
      .panel-card {
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 24px;
      }
      .panel-card h2 { font-size: 15px; margin-bottom: 16px; }
      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
      }
      .form-grid .field-note { grid-column: 1 / -1; }
      .filters {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 18px;
      }
      .filters input, .filters select { width: auto; min-width: 160px; flex: 1; }
      .reports-list { display: flex; flex-direction: column; gap: 10px; }
      .report-item {
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 14px 16px;
      }
      .report-item .report-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
        flex-wrap: wrap;
      }
      .report-item .plate { font-weight: 700; }
      .report-item .badge {
        background: #ff7a1a29;
        color: var(--teal-bright);
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 11.5px;
      }
      .report-item .meta { color: var(--slate); font-size: 12px; }
      .report-item .note { color: var(--paper-dim); font-size: 14px; }
      .empty { color: var(--slate); font-size: 14px; padding: 20px 0; text-align: center; }
      @media (max-width: 700px) {
        .form-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    {!authed ? (
      <div class="login-wrap">
        <div class="login-box">
          <h1>Panel interno</h1>
          <p>Acceso solo para personal de TuGPS24.</p>
          {loginError && <p class="error-msg">Clave incorrecta, intenta de nuevo.</p>}
          <form method="POST" action="/api/internal-login">
            <div class="field">
              <label for="password">Clave de acceso</label>
              <input id="password" name="password" type="password" required autofocus />
            </div>
            <button class="btn" type="submit" style="width:100%;">Entrar</button>
          </form>
        </div>
      </div>
    ) : (
      <div class="wrap">
        <header class="panel-head">
          <h1>Panel interno — Reportes y novedades</h1>
          <form method="POST" action="/api/internal-logout">
            <button class="btn-ghost" type="submit">Cerrar sesión</button>
          </form>
        </header>

        <div class="panel-card">
          <h2>Nuevo reporte</h2>
          <form id="reportForm">
            <div class="form-grid">
              <div class="field">
                <label for="plate">Placa / identificador</label>
                <input id="plate" name="plate" type="text" placeholder="GKX740" required />
              </div>
              <div class="field">
                <label for="branch">Sucursal</label>
                <select id="branch" name="branch" required>
                  {BRANCHES.map((b) => <option value={b}>{b}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="category">Categoría</label>
                <select id="category" name="category" required>
                  {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
                </select>
              </div>
              <div class="field field-note">
                <label for="note">Nota / detalle</label>
                <textarea id="note" name="note" placeholder="Ej: fuera de área vía Masinga, llamado al principal, confirma todo en orden" required></textarea>
              </div>
            </div>
            <button class="btn" type="submit">Guardar reporte</button>
          </form>
        </div>

        <div class="panel-card">
          <h2>Buscar y filtrar</h2>
          <div class="filters">
            <input id="searchInput" type="text" placeholder="Buscar por placa, sucursal o texto..." />
            <select id="branchFilter">
              <option value="">Todas las sucursales</option>
              {BRANCHES.map((b) => <option value={b}>{b}</option>)}
            </select>
            <select id="categoryFilter">
              <option value="">Todas las categorías</option>
              {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div class="reports-list" id="reportsList">
            <div class="empty">Cargando reportes...</div>
          </div>
        </div>
      </div>
    )}
    <script src="/js/operadores.js" defer></script>
  </body>
</html>
