---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'reportes')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}

const FREQUENCIES = ['Diario', 'Semanal', 'Quincenal', 'Mensual'];
---

<InternoLayout title="Reportes programados" active="reportes" session={session}>
  <div class="panel-card">
    <h2>Nuevo reporte programado</h2>
    <p style="color:var(--slate); font-size:13px; margin-bottom:14px;">
      Reportes recurrentes que hay que sacarle a cada cliente. Al guardarlos, aparecen
      como tarea pendiente según la frecuencia — puedes marcarlos como hechos cuando se
      completen.
    </p>
    <form id="scheduledForm">
      <div class="form-grid cols-4">
        <div class="field">
          <label for="sr-client">Cliente / placa</label>
          <input id="sr-client" type="text" placeholder="Nombre o placa" required />
        </div>
        <div class="field">
          <label for="sr-type">Tipo de reporte</label>
          <input id="sr-type" type="text" placeholder="Ej: Reporte de recorrido" required />
        </div>
        <div class="field">
          <label for="sr-frequency">Frecuencia</label>
          <select id="sr-frequency" required>
            {FREQUENCIES.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="sr-operator">Operador asignado</label>
          <select id="sr-operator" required>
            <option value="">Cargando operadores...</option>
          </select>
        </div>
        <div class="field">
          <label for="sr-duedate">Fecha de entrega (opcional)</label>
          <input id="sr-duedate" type="date" />
        </div>
      </div>
      <button class="btn" type="submit">Guardar reporte programado</button>
    </form>
  </div>
  <div class="panel-card">
    <h2>Reportes</h2>
    <div class="tabs">
      <button class="tab-btn active" data-bucket="" type="button">Todos</button>
      <button class="tab-btn" data-bucket="pendiente" type="button">Pendientes</button>
      <button class="tab-btn" data-bucket="por-realizar" type="button">Por realizar</button>
      <button class="tab-btn" data-bucket="al-dia" type="button">Al día</button>
    </div>
    <div class="list-col" id="scheduledList">
      <div class="empty">Cargando...</div>
    </div>
  </div>
</InternoLayout>

<style is:global>
  .item-actions .date-field { display: flex; flex-direction: column; gap: 2px; }
  .item-actions .date-field span { color: var(--slate); font-size: 10.5px; }
</style>

<script src="/js/interno-reportes.js" defer></script>
