---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canManageAiAgents, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canManageAiAgents(session)) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Agentes IA" active="agentes-ia" session={session}>
  <div class="panel-card">
    <h2>Costo de los agentes</h2>
    <p class="hint">Tarifa de Claude Sonnet (USD por millón de tokens) y la tasa de cambio a pesos — ajústalas si cambian.</p>
    <div class="cost-config-row">
      <label>USD → COP <input id="usdToCop" type="number" step="1" min="0" /></label>
      <label>Precio entrada (USD/M tokens) <input id="inputPrice" type="number" step="0.01" min="0" /></label>
      <label>Precio salida (USD/M tokens) <input id="outputPrice" type="number" step="0.01" min="0" /></label>
      <button class="btn-small" id="saveCostConfigBtn" type="button">Guardar</button>
      <span id="costConfigResult" class="hint" style="margin:0;"></span>
    </div>
  </div>

  <div class="panel-card">
    <h2>Reintentar leads de hoy sin respuesta</h2>
    <p class="hint">Si Andrés se quedó sin poder responder de verdad (por ejemplo, se agotaron los créditos de Anthropic) y algún lead de hoy solo recibió el mensaje genérico de respaldo, esto le manda un mensaje real para retomar la conversación — solo a los que de verdad siguen esperando respuesta.</p>
    <button class="btn-ghost" id="retryTodayBtn" type="button">Reintentar leads de hoy</button>
    <p id="retryTodayResult" style="display:none; margin-top:12px; font-size:13.5px; color:var(--paper-dim);"></p>
  </div>

  <div class="panel-card">
    <h2>Aviso de promoción por sucursal</h2>
    <p class="hint">
      Cuando entra una promoción de instalación después de que Andrés ya atendió clientes con el precio anterior,
      él les escribe para corregirles el precio. Solo puede mandar texto libre a quien le haya escrito en las últimas
      24 horas (regla de WhatsApp); los demás salen en una lista para que la sucursal los contacte a mano.
      Aplica a los leads de WhatsApp de las sucursales con promoción vigente, sin instalar y sin marcar como perdidos.
    </p>
    <div class="period-custom-range">
      <label>Que escribieron desde <input id="promoNoticeSince" type="date" /></label>
      <button class="btn-small" id="promoNoticeSimulateBtn" type="button">Simular (no envía)</button>
      <button class="btn-ghost" id="promoNoticeSendBtn" type="button">Enviar aviso</button>
    </div>
    <div id="promoNoticeResult" style="margin-top:12px; font-size:13.5px; color:var(--paper-dim);"></div>
  </div>

  <div class="panel-card">
    <div class="cal-head">
      <div>
        <h2>Calendario de Andrés</h2>
        <p class="hint" style="margin:4px 0 0;">Por día: conversaciones atendidas (leads nuevos o viejos que escribieron y Andrés respondió), leads nuevos que entraron por primera vez, cuántos concretó (entregó a sucursal) y cuánto gastó en Anthropic en dólares. Fechas en hora de Colombia.</p>
      </div>
      <div class="cal-nav">
        <button class="btn-small" id="calPrevBtn" type="button">‹ Mes anterior</button>
        <strong id="calMonthLabel"></strong>
        <button class="btn-small" id="calNextBtn" type="button">Mes siguiente ›</button>
      </div>
    </div>
    <div class="cal-legend"><span><i class="dot a"></i> Atendidos</span><span><i class="dot n"></i> Nuevos</span><span><i class="dot c"></i> Concretados</span></div>
    <div class="cal-grid" id="calGrid"><div class="empty">Cargando...</div></div>
    <div class="cal-totals" id="calTotals"></div>
  </div>

  <div class="panel-card">
    <h2>Consumo por período</h2>
    <p class="hint">Tokens y costo de cada agente en un rango de fechas — separado del contador acumulado de arriba (ese solo se reinicia a mano).</p>
    <div class="period-buttons">
      <button class="btn-small" data-period="hoy" type="button">Hoy</button>
      <button class="btn-small" data-period="semana" type="button">Esta semana</button>
      <button class="btn-small" data-period="mes" type="button">Este mes</button>
      <button class="btn-small" data-period="custom" type="button">Personalizado</button>
    </div>
    <div class="period-custom-range" id="periodCustomRange" hidden>
      <label>Desde <input id="periodFrom" type="date" /></label>
      <label>Hasta <input id="periodTo" type="date" /></label>
      <button class="btn-small" id="periodCustomBtn" type="button">Consultar</button>
    </div>
    <div id="periodResult" class="period-result"></div>
  </div>

  <div id="agentsList"></div>
</InternoLayout>

<style is:global>
  .cost-config-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: end; }
  .cost-config-row label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--slate); }
  .cost-config-row input { width: 140px; }
  .agent-card { margin-bottom: 16px; }
  .agent-section-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--slate); margin: 14px 0 2px; }
  .agent-usage-row { display: flex; gap: 22px; flex-wrap: wrap; margin: 10px 0 14px; }
  .agent-usage-stat { display: flex; flex-direction: column; }
  .agent-usage-stat .n { font-weight: 700; font-size: 17px; }
  .agent-usage-stat .l { color: var(--slate); font-size: 11.5px; }
  .agent-instructions textarea { width: 100%; min-height: 110px; }
  .agent-instructions-actions { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
  .period-buttons { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
  .period-buttons .btn-small.active { background: var(--amber); border-color: var(--amber); color: var(--ink-900); }
  .period-custom-range { display: flex; gap: 14px; align-items: end; flex-wrap: wrap; margin-top: 12px; }
  .period-custom-range label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--slate); }
  .period-result { margin-top: 14px; }
  .period-agent-row { padding: 10px 0; border-bottom: 1px solid var(--line); }
  .period-agent-row:last-child { border-bottom: none; }
  .period-agent-row .title { font-weight: 700; margin-bottom: 6px; display: block; }

  .cal-head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: flex-start; }
  .cal-nav { display: flex; align-items: center; gap: 10px; }
  .cal-nav strong { min-width: 150px; text-align: center; text-transform: capitalize; }
  .cal-legend { display: flex; gap: 16px; font-size: 12.5px; color: var(--slate); margin: 12px 0 8px; }
  .cal-legend .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; }
  .cal-legend .dot.a { background: #3b82f6; } .cal-legend .dot.n { background: #f59e0b; } .cal-legend .dot.c { background: #22c55e; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
  .cal-grid .cal-dow { font-size: 11.5px; color: var(--slate); text-align: center; padding-bottom: 4px; }
  .cal-day { border: 1px solid var(--line); border-radius: 8px; padding: 6px 8px; min-height: 74px; background: var(--ink-800); font-size: 12px; }
  .cal-day.empty-day { border-style: dashed; opacity: 0.35; }
  .cal-day.today { border-color: var(--accent, #f59e0b); }
  .cal-day.future { opacity: 0.5; }
  .cal-day .d { font-weight: 700; font-size: 13px; margin-bottom: 4px; }
  .cal-day .v { display: flex; justify-content: space-between; gap: 4px; line-height: 1.5; }
  .cal-day .v .a { color: #3b82f6; } .cal-day .v .n { color: #f59e0b; } .cal-day .v .c { color: #22c55e; font-weight: 700; }
  .cal-day .v.cost { color: var(--slate); font-size: 11px; border-top: 1px dashed var(--line); margin-top: 3px; padding-top: 2px; }
  .cal-totals { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 12px; font-size: 13.5px; }
  .cal-totals b { font-size: 16px; }
  @media (max-width: 720px) { .cal-grid { gap: 3px; } .cal-day { min-height: 60px; padding: 4px; font-size: 11px; } .cal-day .v { flex-direction: column; gap: 0; } }
</style>

<script src="/js/interno-agentes-ia.js" defer></script>
