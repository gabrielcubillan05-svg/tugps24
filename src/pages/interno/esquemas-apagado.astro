---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, firstSectionFor, SECTION_PATHS } from '../../lib/auth';
import { getRedis } from '../../lib/redis';
import { readExtraEntries, readOverrides } from '../../pages/api/vehicle-cutoff';
import vehicleCutoffData from '../../lib/vehicle-cutoff-data.json';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'esquemas-apagado')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}

const redis = getRedis();
const [extraRecords, overrides] = redis ? await Promise.all([readExtraEntries(redis), readOverrides(redis)]) : [[], {}];
// A cada registro del archivo estático se le da un id estable por posición ("static-<índice>")
// para poder editarlo — nunca reordenar ni insertar en medio de vehicle-cutoff-data.json, solo
// agregar al final, o esos ids (y los overrides ya guardados con ellos) dejarían de coincidir.
const baseRecords = vehicleCutoffData.map((r, i) => ({ id: `static-${i}`, ...r, ...(overrides[`static-${i}`] || {}) }));
const allRecords = [...baseRecords, ...extraRecords];
---

<InternoLayout title="Esquemas de apagado" active="esquemas-apagado" session={session}>
  <div id="esquemasData" data-records={JSON.stringify(allRecords)} style="display:none;"></div>

  <div class="panel-card esquemas-hero">
    <h2>Esquemas de apagado por vehículo</h2>
    <p class="hint">Referencia de cableado para instalar el corte de bomba/ignición del GPS — {allRecords.length} vehículos registrados. Busca por marca, modelo, año o color de cable.</p>
    <div class="filters esquemas-filters">
      <input id="searchInput" type="text" placeholder="Buscar por marca, modelo, año, color..." autocomplete="off" />
      <select id="marcaFilter"><option value="">Todas las marcas</option></select>
      <select id="tipoFilter">
        <option value="">Bomba o ignición</option>
        <option value="bomba">Corte de bomba</option>
        <option value="ignicion">Corte de ignición</option>
      </select>
    </div>
    <div class="esquemas-count" id="esquemasCount"></div>
  </div>

  <details class="panel-card esquemas-add">
    <summary>Agregar nuevo esquema</summary>
    <form id="addEsquemaForm" class="esquema-form">
      <input name="marca" type="text" placeholder="Marca *" required />
      <input name="modelo" type="text" placeholder="Modelo *" required />
      <input name="anio" type="text" placeholder="Año" />
      <input name="colores" type="text" placeholder="Colores de cable" />
      <label class="esquema-check"><input name="corteBomba" type="checkbox" /> Corte de bomba</label>
      <label class="esquema-check"><input name="corteIgnicion" type="checkbox" /> Corte de ignición</label>
      <textarea name="ubicacion" placeholder="Ubicación / detalle del cableado" rows="2"></textarea>
      <button type="submit" class="btn-primary">Guardar esquema</button>
      <span id="addEsquemaMsg" class="esquema-add-msg"></span>
    </form>
  </details>

  <div class="esquemas-grid" id="esquemasGrid"></div>
</InternoLayout>

<style is:global>
  .esquemas-hero .hint { margin-bottom: 16px; }
  .esquemas-filters input { flex: 2; min-width: 220px; }
  .esquemas-count { color: var(--slate); font-size: 12.5px; margin-top: 4px; }

  .esquemas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .esquema-card {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.15s, transform 0.15s;
  }
  .esquema-card:hover { border-color: var(--amber); transform: translateY(-2px); }
  .esquema-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .esquema-marca { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--teal-bright); font-weight: 700; }
  .esquema-modelo { font-size: 16px; font-weight: 700; color: var(--paper); margin-top: 2px; }
  .esquema-anio { flex-shrink: 0; background: var(--ink-900); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; font-size: 12px; color: var(--paper-dim); white-space: nowrap; }
  .esquema-badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .esquema-badge { font-size: 11px; padding: 3px 10px; border-radius: 999px; font-weight: 600; }
  .esquema-badge.bomba { background: var(--glow-1); color: var(--teal-bright); }
  .esquema-badge.ignicion { background: #4a90d922; color: #7ab8ec; }
  .esquema-colores { display: flex; align-items: center; gap: 8px; background: var(--ink-900); border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; }
  .esquema-swatch { display: flex; flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; overflow: hidden; border: 2px solid var(--ink-800); box-shadow: 0 0 0 1px var(--line); }
  .esquema-swatch span { flex: 1; height: 100%; }
  .esquema-colores-text { font-size: 13px; color: var(--paper); text-transform: capitalize; }
  .esquema-ubicacion { font-size: 12.5px; color: var(--paper-dim); line-height: 1.5; }
  .esquema-ubicacion strong { color: var(--slate); font-weight: 600; }

  .esquemas-add summary { cursor: pointer; font-weight: 600; color: var(--paper); }
  .esquema-form { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .esquema-form input[type="text"], .esquema-form textarea { flex: 1 1 200px; }
  .esquema-form textarea { flex-basis: 100%; resize: vertical; }
  .esquema-check { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--paper-dim); flex: 0 0 auto; }
  .esquema-add-msg { font-size: 12.5px; color: var(--teal-bright); flex-basis: 100%; }
  .esquema-add-msg.error { color: #e0392f; }
</style>

<script src="/js/interno-esquemas-apagado.js" defer></script>
