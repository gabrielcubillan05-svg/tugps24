---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'rrhh')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Recursos Humanos" active="rrhh" session={session}>
  <div class="panel-card">
    <h2>Directorio de empleados</h2>
    <div class="filters">
      <input id="rrhhSearch" type="text" placeholder="Buscar por nombre..." autocomplete="off" />
    </div>
    <div class="records-grid" id="employeeGrid" style="margin-top:14px;">
      <div class="empty">Cargando...</div>
    </div>
  </div>

  <div class="panel-card" id="fichaPanel" hidden>
    <h2 id="fichaNombre">Ficha del empleado</h2>
    <button class="btn-small" id="fichaCerrar" type="button" style="margin-bottom:16px;">Cerrar</button>

    <h3 class="ficha-section-title">Información personal</h3>
    <div class="form-grid cols-4">
      <div class="field"><label>Cédula</label><input id="f-cedula" type="text" /></div>
      <div class="field"><label>Fecha de nacimiento</label><input id="f-fechaNacimiento" type="date" /></div>
      <div class="field"><label>Hijos (cantidad)</label><input id="f-hijos" type="number" min="0" /></div>
      <div class="field"><label>Edades de los hijos</label><input id="f-hijosEdades" type="text" placeholder="ej. 5, 9" /></div>
      <div class="field"><label>Teléfono</label><input id="f-telefono" type="text" /></div>
      <div class="field field-note"><label>Dirección</label><input id="f-direccion" type="text" /></div>
      <div class="field"><label>Correo</label><input id="f-correo" type="email" /></div>
    </div>

    <h3 class="ficha-section-title">Información laboral</h3>
    <div class="form-grid cols-4">
      <div class="field"><label>Área</label><input id="f-area" type="text" /></div>
      <div class="field"><label>Cargo</label><input id="f-cargo" type="text" /></div>
      <div class="field"><label>Jefe directo</label><input id="f-jefeDirecto" type="text" /></div>
      <div class="field"><label>Sucursal(es)</label><div id="f-sucursales" class="ficha-readonly"></div></div>
    </div>

    <h3 class="ficha-section-title">Vinculación</h3>
    <div class="form-grid cols-4">
      <div class="field"><label>Fecha de ingreso</label><input id="f-hireDate" type="date" /></div>
      <div class="field"><label>Antigüedad</label><div id="f-antiguedad" class="ficha-readonly"></div></div>
      <div class="field field-full"><label>Contratos registrados</label><div id="f-contratos" class="ficha-readonly"></div></div>
    </div>

    <h3 class="ficha-section-title">Afiliaciones</h3>
    <div class="form-grid cols-4">
      <div class="field"><label>EPS</label><input id="f-eps" type="text" /></div>
      <div class="field"><label class="day-check"><input id="f-cajaCompensacion" type="checkbox" /> Caja de compensación</label></div>
      <div class="field"><label class="day-check"><input id="f-cuentaNomina" type="checkbox" /> Cuenta nómina</label></div>
      <div class="field"><label class="day-check"><input id="f-nesagaviria" type="checkbox" /> Nesagaviria</label></div>
    </div>
    <button class="btn" id="fichaGuardar" type="button">Guardar ficha</button>
    <span id="fichaMsg" class="esquema-add-msg"></span>

    <h3 class="ficha-section-title">Vacaciones</h3>
    <div id="f-vacaciones" class="ficha-readonly" style="margin-bottom:20px;"></div>

    <h3 class="ficha-section-title">Incapacidades</h3>
    <form id="incapForm" class="esquema-form" style="margin-bottom:14px;">
      <input id="inc-start" type="date" required />
      <input id="inc-end" type="date" required />
      <input id="inc-note" type="text" placeholder="Nota (opcional)" />
      <button class="btn-small btn-done" type="submit">Agregar incapacidad</button>
    </form>
    <div class="records-grid" id="incapList"></div>
  </div>
</InternoLayout>

<style is:global>
  .records-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .employee-card {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    cursor: pointer;
    transition: border-color 0.15s, transform 0.15s;
  }
  .employee-card:hover { border-color: var(--amber); transform: translateY(-2px); }
  .employee-card .title { font-weight: 700; color: var(--paper); }
  .employee-card .meta { color: var(--slate); font-size: 12.5px; margin-top: 4px; }
  .ficha-section-title { font-size: 13.5px; color: var(--paper-dim); margin: 18px 0 10px; }
  .ficha-readonly { color: var(--paper); font-size: 13.5px; padding: 8px 0; }
  .esquema-form { display: flex; flex-wrap: wrap; gap: 10px; }
  .esquema-add-msg { font-size: 12.5px; color: var(--teal-bright); margin-left: 10px; }
  .esquema-add-msg.error { color: #e0392f; }
</style>

<script src="/js/interno-rrhh.js" defer></script>
