---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canViewWhatsappConversations, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canViewWhatsappConversations(session)) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Conversaciones de WhatsApp" active="" session={session}>
  <div class="panel-card">
    <h2>Conversaciones del agente IA (Andrés)</h2>
    <div class="filters">
      <input id="searchInput" type="text" placeholder="Buscar por nombre o teléfono..." />
      <select id="stageFilter">
        <option value="">Todos los estados</option>
        <option value="en_conversacion">En conversación</option>
        <option value="entregado">Entregado a sucursal</option>
        <option value="escalado">Escalado</option>
        <option value="sin_iniciar">Sin iniciar</option>
      </select>
    </div>
    <div class="conversations-layout">
      <div class="conversations-list" id="conversationsList">
        <div class="empty">Cargando...</div>
      </div>
      <div class="conversation-thread" id="conversationThread">
        <div class="empty">Selecciona una conversación de la izquierda.</div>
      </div>
    </div>
  </div>
</InternoLayout>

<style is:global>
  .conversations-layout { display: flex; gap: 16px; margin-top: 14px; align-items: flex-start; }
  .conversations-list {
    flex: 0 0 320px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 70vh;
    overflow-y: auto;
  }
  .conversation-row {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 12px;
    cursor: pointer;
  }
  .conversation-row:hover { border-color: var(--amber); }
  .conversation-row.active { border-color: var(--amber); background: #ff7a1a14; }
  .conversation-row .name { font-weight: 700; font-size: 13.5px; }
  .conversation-row .meta { color: var(--slate); font-size: 11.5px; margin-top: 2px; }
  .conversation-thread {
    flex: 1;
    min-width: 0;
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
    max-height: 70vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .thread-header { margin-bottom: 8px; }
  .thread-header .name { font-weight: 700; font-size: 15px; }
  .thread-header .meta { color: var(--slate); font-size: 12px; }
  .msg-bubble { max-width: 75%; padding: 8px 12px; border-radius: 10px; font-size: 13px; white-space: pre-wrap; }
  .msg-bubble.user { align-self: flex-start; background: var(--ink-700); }
  .msg-bubble.assistant { align-self: flex-end; background: #2f8a4f2e; }
  .msg-bubble .who { display: block; font-size: 10.5px; color: var(--slate); margin-bottom: 3px; }
  @media (max-width: 900px) {
    .conversations-layout { flex-direction: column; }
    .conversations-list { flex: 1 1 auto; max-height: 260px; width: 100%; }
  }
</style>

<script src="/js/interno-conversaciones-whatsapp.js" defer></script>
