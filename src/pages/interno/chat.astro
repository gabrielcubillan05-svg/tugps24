---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'chat')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Chat" active="chat" session={session}>
  <div id="chatData" data-is-admin={String(session.role === 'admin')} style="display:none;"></div>
  <div class="chat-layout">
    <div class="panel-card chat-sidebar">
      <div class="chat-sidebar-head">
        <svg class="chat-logo" viewBox="0 0 128 128" fill="none"><path d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z" fill="currentColor"/></svg>
        <span>Chat</span>
      </div>
      <div class="chat-actions">
        <button class="btn-small" id="newDmBtn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="12" y1="8" x2="12" y2="13"/><line x1="9.5" y1="10.5" x2="14.5" y2="10.5"/></svg>
          Mensaje
        </button>
        <button class="btn-small" id="newGroupBtn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Grupo
        </button>
      </div>
      {session.role === 'admin' && (
        <div class="chat-mode-toggle">
          <button class="btn-small active" id="modeMyChats" type="button">Mis chats</button>
          <button class="btn-small" id="modeAllChats" type="button" title="Ver todas las conversaciones (solo lectura)">Todos los chats (admin)</button>
        </div>
      )}
      <div id="conversationList" class="list-col"><div class="empty">Cargando...</div></div>
    </div>
    <div class="panel-card chat-main">
      <div id="chatHeader" class="chat-header">Selecciona una conversación</div>
      <div id="messagesArea" class="messages-area">
        <div class="chat-empty-state">
          <svg viewBox="0 0 128 128" fill="none"><path d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-1.1 28.2Zm-4.2-20.2c-2 6.6-.6 15.8 4.2 20.2a17.5 17.5 0 0 1 .2-.7 5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1a73 73 0 0 0 3.2-2.2 16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z" fill="currentColor"/></svg>
          <p>Selecciona una conversación para empezar</p>
        </div>
      </div>
      <form id="messageForm" class="message-form" style="display:none; position:relative;">
        <button class="btn-small btn-emoji" id="emojiBtn" type="button" aria-label="Emojis" title="Emojis">🙂</button>
        <div class="emoji-panel" id="emojiPanel" style="display:none;"></div>
        <input id="messageInput" type="text" placeholder="Escribe un mensaje..." autocomplete="off" />
        <button class="btn btn-send" type="submit" aria-label="Enviar" title="Enviar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </form>
    </div>
  </div>
</InternoLayout>

<div class="modal-overlay" id="dmModalOverlay" style="display:none;">
  <div class="modal-box">
    <h2>Nuevo mensaje</h2>
    <div class="field">
      <label for="dmUserSelect">Empleado</label>
      <select id="dmUserSelect"><option value="">Cargando...</option></select>
    </div>
    <div style="display:flex; gap:10px; margin-top:8px;">
      <button class="btn" id="dmStartBtn" type="button">Iniciar</button>
      <button class="btn-ghost" id="dmCancelBtn" type="button">Cancelar</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="groupModalOverlay" style="display:none;">
  <div class="modal-box">
    <h2>Nuevo grupo</h2>
    <div class="field">
      <label for="groupNameInput">Nombre del grupo</label>
      <input id="groupNameInput" type="text" placeholder="Ej: Operadores Riohacha" />
    </div>
    <div class="field">
      <label for="groupMemberSearch">Miembros</label>
      <input id="groupMemberSearch" type="text" placeholder="Buscar empleado..." style="margin-bottom:8px;" />
      <div id="groupMembersList" class="group-members-list"></div>
    </div>
    <p id="groupError" class="error-msg" style="display:none;"></p>
    <div style="display:flex; gap:10px; margin-top:8px;">
      <button class="btn" id="groupCreateBtn" type="button">Crear grupo</button>
      <button class="btn-ghost" id="groupCancelBtn" type="button">Cancelar</button>
    </div>
  </div>
</div>

<style is:global>
  .chat-layout { display: grid; grid-template-columns: 280px 1fr; gap: 16px; align-items: start; }
  .chat-sidebar { max-height: 72vh; overflow-y: auto; }
  .chat-sidebar-head {
    display: flex; align-items: center; gap: 8px; padding-bottom: 12px; margin-bottom: 12px;
    border-bottom: 1px solid var(--line); color: var(--slate); font-weight: 600; font-size: 13px;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .chat-logo { width: 20px; height: 20px; color: var(--amber); flex-shrink: 0; opacity: 0.9; }
  .chat-actions { display: flex; gap: 8px; margin-bottom: 14px; }
  .chat-actions .btn-small { display: inline-flex; align-items: center; gap: 6px; }
  .chat-actions .btn-small svg { width: 14px; height: 14px; }
  .chat-mode-toggle { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
  .chat-mode-toggle .btn-small.active { background: var(--amber); color: #1a0f00; border-color: var(--amber); font-weight: 600; }
  .oversight-banner {
    background: #ff7a1a1a; border: 1px solid var(--amber); color: var(--teal-bright);
    font-size: 12px; padding: 8px 10px; border-radius: 8px; margin-bottom: 10px;
  }
  .chat-main { display: flex; flex-direction: column; height: 72vh; }
  .chat-header { font-weight: 700; padding-bottom: 10px; border-bottom: 1px solid var(--line); margin-bottom: 10px; }
  .messages-area { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding: 4px 2px; }
  .chat-empty-state {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px; color: var(--slate); text-align: center;
  }
  .chat-empty-state svg { width: 56px; height: 56px; opacity: 0.15; color: var(--paper); }
  .chat-empty-state p { font-size: 13.5px; }
  .message-form { display: flex; gap: 8px; margin-top: 10px; }
  .message-form input { flex: 1; }
  .btn-send { width: 44px; padding: 0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .btn-send svg { width: 18px; height: 18px; }
  .btn-emoji { width: 40px; padding: 0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 18px; }
  .emoji-panel {
    position: absolute;
    bottom: 52px;
    left: 0;
    width: 260px;
    max-height: 200px;
    overflow-y: auto;
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    padding: 8px;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    z-index: 60;
  }
  .emoji-panel button {
    background: none; border: none; font-size: 19px; padding: 5px; cursor: pointer;
    border-radius: 6px; width: auto;
  }
  .emoji-panel button:hover { background: var(--ink-900); }
  .msg { max-width: 72%; padding: 8px 12px; border-radius: 12px; font-size: 13.5px; display: flex; gap: 8px; align-items: flex-end; }
  .msg.mine { align-self: flex-end; background: var(--amber); color: #1a0f00; }
  .msg.theirs { align-self: flex-start; background: var(--ink-900); border: 1px solid var(--line); }
  .msg .msg-body { min-width: 0; }
  .msg .msg-sender { display: block; font-size: 11px; opacity: 0.75; margin-bottom: 2px; font-weight: 600; }
  .date-divider { display: flex; justify-content: center; margin: 10px 0; }
  .date-divider span {
    background: var(--ink-900); border: 1px solid var(--line); color: var(--slate);
    font-size: 11px; padding: 4px 12px; border-radius: 999px;
  }
  .msg .msg-time { display: block; font-size: 10px; opacity: 0.6; margin-top: 3px; }
  .msg-check { letter-spacing: -2px; opacity: 0.85; font-size: 12px; font-weight: 700; margin-left: 2px; }
  .msg-check.read { color: #2f8fd1; opacity: 1; }
  .avatar {
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 30px; height: 30px; border-radius: 50%; font-size: 12px; font-weight: 700;
    background: var(--teal-bright); color: #1a0f00;
  }
  .avatar.avatar-sm { width: 22px; height: 22px; font-size: 10px; }
  .avatar.avatar-group { background: var(--amber); }
  .conv-item {
    padding: 10px; border-radius: 8px; cursor: pointer; margin-bottom: 4px; display: flex;
    align-items: center; gap: 10px;
  }
  .conv-item:hover, .conv-item.active { background: var(--ink-900); }
  .conv-item .conv-info { min-width: 0; flex: 1; }
  .conv-item .conv-name { font-weight: 600; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .conv-item .conv-preview { font-size: 12px; color: var(--slate); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .group-members-list { max-height: 180px; overflow-y: auto; border: 1px solid var(--line); border-radius: 8px; padding: 4px 10px; }
  .group-members-list label {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    font-size: 13px; padding: 7px 0; width: auto; border-bottom: 1px solid var(--line);
  }
  .group-members-list label:last-child { border-bottom: none; }
  .group-members-list label.hidden { display: none; }
  .group-members-list input[type="checkbox"] {
    width: 16px; height: 16px; padding: 0; margin: 0; background: none;
    border: 1px solid var(--line); border-radius: 4px; flex-shrink: 0; accent-color: var(--amber);
  }
  @media (max-width: 700px) {
    .chat-layout { grid-template-columns: 1fr; }
    .chat-sidebar { max-height: 220px; }
  }
</style>

<script src="/js/interno-chat.js" defer></script>
