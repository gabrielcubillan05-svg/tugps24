---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, canAssignTasks, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'tareas')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}

const canAssign = canAssignTasks(session.role);
const isAdmin = session.role === 'admin';
---

<InternoLayout title="Tareas" active="tareas" session={session}>
  <div id="tareasData" data-can-assign={String(canAssign)} data-is-admin={String(isAdmin)} style="display:none;"></div>

  <div class="panel-card">
    <h2>Tablero</h2>
    <div class="tasks-board" id="tasksBoard"></div>
  </div>

  {canAssign && (
    <div class="panel-card">
      <h2>Nueva tarea</h2>
      <form id="taskForm">
        <div class="form-grid">
          <div class="field field-full">
            <label for="t-title">Título</label>
            <input id="t-title" type="text" placeholder="Ej: Revisar instalación GPS moto ABC123" required />
          </div>
          <div class="field field-note">
            <label for="t-description">Descripción (opcional)</label>
            <textarea id="t-description" placeholder="Detalles de la tarea"></textarea>
          </div>
          <div class="field">
            <label for="t-assignee">Asignar a</label>
            <select id="t-assignee" required>
              <option value="">Cargando empleados...</option>
            </select>
          </div>
          <div class="field">
            <label for="t-duedate">Fecha de vencimiento</label>
            <input id="t-duedate" type="date" />
          </div>
        </div>
        <button class="btn" type="submit">Asignar tarea</button>
      </form>
    </div>
  )}

  <div class="panel-card">
    <h2>{canAssign ? 'Todas las tareas' : 'Mis tareas'}</h2>
    <div class="filters">
      {canAssign && (
        <select id="assigneeFilter"><option value="">Todos los empleados</option></select>
      )}
      <select id="statusFilter">
        <option value="">Todos los estados</option>
        <option value="Pendiente">Pendiente</option>
        <option value="En progreso">En progreso</option>
        <option value="Completada">Completada</option>
        <option value="Cancelada">Cancelada</option>
      </select>
      <label class="checkbox"><input type="checkbox" id="overdueFilter" /> Solo atrasadas</label>
    </div>
    <div class="list-col" id="tasksList">
      <div class="empty">Cargando...</div>
    </div>
  </div>
</InternoLayout>

<style is:global>
  .task-item {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 12px;
  }
  .task-item.overdue { border-color: var(--danger); background: #e0563f14; }
  .task-top { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; align-items: center; }
  .task-title { font-weight: 700; font-size: 15px; }
  .task-meta { color: var(--slate); font-size: 12.5px; margin-bottom: 10px; }
  .task-desc { color: var(--paper-dim); font-size: 14px; margin-bottom: 10px; }
  .badge.Pendiente { background: #ffab5c33; color: var(--teal-bright); }
  .badge.En-progreso { background: #4a90d922; color: #7ab8ec; }
  .badge.Completada { background: #2f8a4f33; color: var(--ok); }
  .badge.Cancelada { background: #e0563f22; color: var(--danger); }
  .badge.overdue-badge { background: var(--danger); color: #fff; }
  .task-controls { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; align-items: center; }
  .task-controls select { width: auto; padding: 7px 9px; font-size: 12.5px; }
  .proof-thumb { display: block; width: 90px; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); margin-bottom: 10px; }
  .followup-section {
    margin-top: 12px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--ink-900);
  }
  .followup-section h4 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--slate);
    margin-bottom: 8px;
    font-weight: 600;
  }
  .notes-list { border-top: 1px solid var(--line); margin-top: 10px; padding-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .notes-list .note-item { font-size: 12.5px; color: var(--paper-dim); }

  .tasks-board { overflow-x: auto; padding-bottom: 8px; }
  .board-columns { display: flex; gap: 12px; min-width: min-content; }
  .board-col {
    flex: 0 0 250px;
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px;
    display: flex;
    flex-direction: column;
  }
  .board-col-head { display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 13px; margin-bottom: 10px; }
  .board-col-head .board-count { color: var(--slate); font-weight: 500; font-size: 11.5px; }
  .board-col-body { display: flex; flex-direction: column; gap: 8px; min-height: 60px; border-radius: 8px; transition: background 0.15s; }
  .board-col-body.drag-over { background: #ff7a1a1f; }
  .board-empty { color: var(--slate); font-size: 12px; text-align: center; padding: 14px 0; }
  .board-card {
    background: var(--ink-700);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 10px;
    cursor: grab;
  }
  .board-card[draggable="false"] { cursor: default; }
  .board-card.dragging { opacity: 0.45; }
  .board-card.overdue { border-color: var(--danger); }
  .board-card-title { font-weight: 600; font-size: 13px; margin-bottom: 2px; }
  .board-card-meta { color: var(--slate); font-size: 11.5px; margin-bottom: 6px; }
  .board-card-badges { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
  .board-card-badges .badge { font-size: 10px; padding: 1px 7px; }
  .board-card .proof-thumb { width: 100%; height: 70px; margin-bottom: 0; }
  .notes-list .note-item .note-date { color: var(--slate); font-size: 11px; margin-right: 6px; }
  .add-note-row { display: flex; gap: 8px; }
  .add-note-row input { flex: 1; }
</style>

<script src="/js/interno-tareas.js" defer></script>
