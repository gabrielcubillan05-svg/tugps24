---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, getSession, canAccessSection, canManageCompDays, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (!canAccessSection(session.role, 'horario')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}

const canCompDays = canManageCompDays(session.role);
const DAYS = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
---

<InternoLayout title="Horario" active="horario" session={session}>
  <div class="panel-card">
    <h2>Horario de empleados</h2>
    <p style="color:var(--slate); font-size:13px; margin-bottom:14px;">
      Si un empleado tiene horario mixto (turnos distintos según el día), agrega una franja a la vez —
      puedes guardar varias para el mismo empleado y todas quedarán listadas juntas.
    </p>
    <form id="scheduleForm">
      <div class="form-grid">
        <div class="field">
          <label for="sc-operator">Empleado</label>
          <select id="sc-operator" required>
            <option value="">Cargando empleados...</option>
          </select>
        </div>
        <div class="field">
          <label for="sc-start">Hora inicio</label>
          <input id="sc-start" type="time" required />
        </div>
        <div class="field">
          <label for="sc-end">Hora fin</label>
          <input id="sc-end" type="time" required />
        </div>
        <div class="field field-note">
          <label>Días</label>
          <div class="day-checks">
            {DAYS.map((d) => (
              <label class="day-check"><input type="checkbox" class="sc-day" value={d} /> {d.slice(0, 3)}</label>
            ))}
          </div>
        </div>
      </div>
      <button class="btn" type="submit">Agregar franja</button>
      <p id="scheduleError" class="error-msg" style="display:none; margin-top:10px;"></p>
    </form>
  </div>
  <div class="panel-card">
    <h2>Horarios actuales</h2>
    <div class="list-col" id="scheduleList">
      <div class="empty">Cargando...</div>
    </div>
  </div>

  <div class="panel-card">
    <h2>Días compensatorios</h2>
    {canCompDays ? (
      <div id="compDaysArea">
        <form id="compDaysForm" style="margin-bottom:20px;">
          <div class="form-grid cols-4">
            <div class="field">
              <label for="cd-operator">Empleado</label>
              <select id="cd-operator" required>
                <option value="">Cargando empleados...</option>
              </select>
            </div>
            <div class="field">
              <label for="cd-days">Días (+ / -)</label>
              <input id="cd-days" type="number" step="1" placeholder="Ej: 1 o -1" required />
            </div>
            <div class="field">
              <label for="cd-scheduled">Fecha en que se dará (opcional)</label>
              <input id="cd-scheduled" type="date" />
            </div>
            <div class="field field-note">
              <label for="cd-note">Nota</label>
              <input id="cd-note" type="text" placeholder="Motivo" />
            </div>
          </div>
          <button class="btn" type="submit">Registrar</button>
        </form>
        <h3 style="font-size:13.5px; color:var(--paper-dim); margin-bottom:10px;">Días acumulados por empleado</h3>
        <div class="stats-row" id="compDaysTotals" style="margin-bottom:20px;"></div>
        <div class="list-col" id="compDaysList">
          <div class="empty">Cargando...</div>
        </div>
      </div>
    ) : (
      <div class="supervisor-gate">
        <p style="color:var(--slate); font-size:13.5px;">
          Esta sección es solo para supervisores, gerentes y administradores.
        </p>
      </div>
    )}
  </div>

  <div class="panel-card">
    <h2>Contratos y vacaciones</h2>
    {canCompDays ? (
      <div id="contractsArea">
        <form id="contractForm" style="margin-bottom:20px;">
          <div class="form-grid cols-4">
            <div class="field">
              <label for="ct-employee">Empleado</label>
              <select id="ct-employee" required>
                <option value="">Cargando empleados...</option>
              </select>
            </div>
            <div class="field">
              <label for="ct-type">Tipo</label>
              <select id="ct-type" required>
                <option value="Contrato">Contrato</option>
                <option value="Vacaciones">Vacaciones</option>
              </select>
            </div>
            <div class="field">
              <label for="ct-start">Fecha inicio</label>
              <input id="ct-start" type="date" required />
            </div>
            <div class="field">
              <label for="ct-end">Fecha fin</label>
              <input id="ct-end" type="date" />
              <label class="day-check" style="margin-top:8px;">
                <input type="checkbox" id="ct-indefinite" /> Contrato indefinido (sin fecha fin)
              </label>
            </div>
            <div class="field field-note">
              <label for="ct-note">Nota</label>
              <input id="ct-note" type="text" placeholder="Detalle (opcional)" />
            </div>
          </div>
          <button class="btn" type="submit">Registrar</button>
        </form>
        <h3 style="font-size:13.5px; color:var(--paper-dim); margin-bottom:10px;">Balance de vacaciones por empleado</h3>
        <div class="list-col" id="vacationBalances" style="margin-bottom:20px;"></div>
        <div class="list-col" id="contractsList">
          <div class="empty">Cargando...</div>
        </div>
      </div>
    ) : (
      <div class="supervisor-gate">
        <p style="color:var(--slate); font-size:13.5px;">
          Esta sección es solo para supervisores, gerentes y administradores.
        </p>
      </div>
    )}
  </div>
</InternoLayout>

<style is:global>
  .day-checks { display: flex; gap: 10px; flex-wrap: wrap; }
  .day-check {
    display: flex;
    align-items: center;
    gap: 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12.5px;
    color: var(--paper-dim);
    cursor: pointer;
    width: auto;
  }
  .day-check input { width: auto; }
  .badge.status-vencido { background: var(--danger); color: #fff; }
  .badge.status-proximo, .badge.status-proxima { background: #ff7a1a29; color: var(--teal-bright); }
  .badge.status-indefinido { background: #2f8a4f33; color: var(--ok); }
</style>

<script src="/js/interno-horario.js" defer></script>
