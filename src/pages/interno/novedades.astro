---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'novedades')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}

const CATEGORIES = ['Notificación', 'Salida de geocerca', 'Finalizado', 'Alarma', 'Novedad', 'Monitoreo a', 'Monitoreo en', 'Monitoreo vía', 'Monitoreo retornando', 'Otro'];
const BRANCHES = ['Riohacha', 'Valledupar', 'Santa Marta', 'Maicao', 'Atlántico', 'Bucaramanga', 'Medellín', 'Montería'];
---

<InternoLayout title="Novedades" active="novedades" session={session}>
  <div class="panel-card">
    <h2>Nuevo reporte</h2>
    <form id="reportForm">
      <div class="form-grid">
        <div class="field">
          <label for="plate">Placa / identificador</label>
          <input id="plate" name="plate" type="text" placeholder="GKX740" required />
        </div>
        <div class="field">
          <label for="branch">Sucursal</label>
          <select id="branch" name="branch" required>
            {BRANCHES.map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="category">Categoría</label>
          <select id="category" name="category" required>
            {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
        <div class="field field-note">
          <label for="note">Nota / detalle</label>
          <textarea id="note" name="note" placeholder="Ej: fuera de área vía Masinga, llamado al principal, confirma todo en orden" required></textarea>
        </div>
        <div class="field field-note">
          <label>¿Apagaste o encendiste el vehículo en esta novedad?</label>
          <div class="power-toggles">
            <button type="button" class="shutdown-toggle" id="shutdownToggle" aria-pressed="false">
              <span class="dot"></span><span class="txt">Lo apagué</span>
            </button>
            <button type="button" class="shutdown-toggle poweron" id="powerOnToggle" aria-pressed="false">
              <span class="dot"></span><span class="txt">Lo encendí</span>
            </button>
          </div>
        </div>
        <div class="field field-note">
          <label for="images">Fotos (opcional, máx. 4) — puedes pegar una captura con Ctrl+V dentro de la nota</label>
          <input id="images" name="images" type="file" accept="image/*" multiple />
          <div class="image-preview" id="imagePreview"></div>
        </div>
      </div>
      <button class="btn" type="submit">Guardar reporte</button>
    </form>
  </div>

  <div class="panel-card">
    <h2>Buscar y filtrar</h2>
    <div class="filters">
      <input id="searchInput" type="text" placeholder="Buscar por placa, sucursal o texto..." />
      <select id="branchFilter">
        <option value="">Todas las sucursales</option>
        {BRANCHES.map((b) => <option value={b}>{b}</option>)}
      </select>
      <select id="categoryFilter">
        <option value="">Todas las categorías</option>
        {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
      </select>
      <select id="employeeFilter">
        <option value="">Todos los empleados</option>
      </select>
      <label class="shutdown-filter"><input id="shutdownFilter" type="checkbox" /> 🔴 Solo con orden de apagado vigente</label>
    </div>
    <p id="truncatedNotice" class="hint" style="display:none;"></p>
    <div class="reports-list" id="reportsList">
      <div class="empty">Cargando reportes...</div>
    </div>
  </div>
</InternoLayout>

<style is:global>
  #truncatedNotice { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
</style>


<style>
  .shutdown-toggle { display: inline-flex; align-items: center; gap: 10px; width: auto; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--ink-800); color: var(--paper-dim); font-size: 14px; cursor: pointer; }
  .shutdown-toggle .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--slate); }
  .shutdown-toggle[aria-pressed="true"] { background: var(--danger); border-color: var(--danger); color: #fff; font-weight: 700; }
  .shutdown-toggle[aria-pressed="true"] .dot { background: #fff; box-shadow: 0 0 0 4px rgba(255,255,255,0.25); }
  .shutdown-toggle.poweron[aria-pressed="true"] { background: var(--ok); border-color: var(--ok); }
  .power-toggles { display: flex; gap: 10px; flex-wrap: wrap; }
  .report-item .badge.poweron { background: var(--ok); color: #fff; font-weight: 700; margin-left: 6px; }
  .shutdown-filter { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; color: var(--paper-dim); white-space: nowrap; cursor: pointer; }
  .shutdown-filter input { width: auto; margin: 0; }
  .report-item .badge.shutdown { background: var(--danger); color: #fff; font-weight: 700; margin-left: 6px; }
</style>
<script src="/js/interno-novedades.js" defer></script>
