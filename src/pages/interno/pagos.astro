---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessPagos, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessPagos(session)) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Verificación de pagos" active="pagos" session={session}>
  <div class="panel-card">
    <h2>Subir comprobantes</h2>
    <p class="hint">Selecciona o pega (Ctrl+V) hasta 20 fotos de comprobantes a la vez. El monto, la fecha y el nombre de quien paga se leen solos de cada imagen — revisa que hayan quedado bien (o complétalos si no se pudieron leer) antes de guardar.</p>
    <div class="receipt-upload-row">
      <input id="rp-file" type="file" accept="image/*" multiple />
      <span class="hint" style="margin:0;">También puedes pegar varias fotos con Ctrl+V.</span>
    </div>
    <div id="pendingReceiptsQueue" class="pending-queue"></div>
    <button class="btn" id="saveAllReceiptsBtn" type="button" disabled>Guardar comprobantes</button>
  </div>

  <div class="panel-card">
    <h2>Verificar contra movimientos del banco</h2>
    <p class="hint">Sube el archivo de movimientos que descargas de Bancolombia. Se compara cada comprobante pendiente contra los movimientos por monto y fecha; si el nombre no alcanza a distinguir un pago repetido el mismo día, queda marcado para que lo confirmes a mano.</p>
    <form id="verifyReceiptsForm" class="verify-installs-form">
      <input id="verifyReceiptsFile" type="file" accept=".xlsx,.xls,.csv" required />
      <button class="btn-small" type="submit">Comparar y verificar</button>
    </form>
    <div id="verifyReceiptsResult"></div>
  </div>

  <div class="panel-card">
    <h2>Comparar con Optimus</h2>
    <p class="hint">Sube el Excel de pagos que exportas de Optimus (con columnas Cliente y Monto). Se compara contra los comprobantes verificados para detectar anomalías: pagos en Optimus sin comprobante, comprobantes sin registrar en Optimus, o montos que no coinciden.</p>
    <form id="compareOptimusForm" class="verify-installs-form">
      <input id="compareOptimusFile" type="file" accept=".xlsx,.xls,.csv" required />
      <button class="btn-small" type="submit">Comparar</button>
    </form>
    <div id="compareOptimusResult"></div>
  </div>

  <div class="panel-card">
    <h2>Comprobantes</h2>
    <div class="tabs">
      <button class="tab-btn active" data-status="" type="button">Todos</button>
      <button class="tab-btn" data-status="pendiente" type="button">Pendientes</button>
      <button class="tab-btn" data-status="verificado" type="button">Verificados</button>
      <button class="tab-btn" data-status="no-encontrado" type="button">Sin encontrar</button>
    </div>
    <div class="receipt-gallery" id="receiptGallery">
      <div class="empty">Cargando...</div>
    </div>
  </div>
</InternoLayout>

<style is:global>
  .receipt-upload-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .pending-queue { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-bottom: 14px; }
  .pending-item {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pending-item.has-error { border-color: var(--danger); }
  .pending-item.has-warning { border-color: var(--amber); }
  .pending-thumb { width: 100%; aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; background: var(--ink-900, #0e0d0b); }
  .pending-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .pending-fields { display: flex; flex-direction: column; gap: 5px; }
  .pending-fields input { font-size: 12.5px; padding: 6px 8px; }
  .pending-status { font-size: 11.5px; color: var(--slate); }
  .pending-status.error { color: var(--danger); }
  .pending-status.warning { color: var(--amber); font-weight: 600; }
  .pending-status.ok { color: var(--ok); }
  .receipt-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-top: 14px; }
  .receipt-item {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .receipt-thumb {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 8px;
    overflow: hidden;
    background: var(--ink-900, #0e0d0b);
  }
  .receipt-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .receipt-amount { font-weight: 700; font-size: 15px; }
  .receipt-meta { color: var(--slate); font-size: 12px; }
  .receipt-note { font-size: 12.5px; }
  .receipt-mismatch { color: var(--amber); font-size: 11.5px; }
  .receipt-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: auto; }
  .badge.pendiente { background: #ff7a1a29; color: var(--amber); }
  .badge.verificado { background: #2f8a4f33; color: var(--ok); }
  .badge.no-encontrado { background: #e0563f22; color: var(--danger); }
  #verifyReceiptsResult .result-ok { color: var(--ok); }
  #verifyReceiptsResult .result-error { color: var(--danger); }
  #compareOptimusResult .result-error { color: var(--danger); }
  .optimus-stats-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0 18px; }
  .optimus-tables { display: flex; flex-direction: column; gap: 18px; }
  .optimus-tables h3 { font-size: 13px; margin-bottom: 6px; }
  .optimus-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .optimus-table th, .optimus-table td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: left; }
  .optimus-table th { color: var(--slate); font-weight: 600; font-size: 11.5px; }
  .optimus-table td.amount-bad { color: var(--danger); font-weight: 600; }
</style>

<script src="/js/interno-pagos.js" defer></script>
