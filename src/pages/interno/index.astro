---
export const prerender = false;

import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) {
  return Astro.redirect(LOGIN_PATH);
}
if (session.mustChangePassword) {
  return Astro.redirect(CHANGE_PASSWORD_PATH);
}
const section = firstSectionFor(session.role);
return Astro.redirect(section ? SECTION_PATHS[section] : LOGIN_PATH);
---
