---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) {
  return Astro.redirect(LOGIN_PATH);
}
if (session.mustChangePassword) {
  return Astro.redirect(CHANGE_PASSWORD_PATH);
}
---

<InternoLayout title="Inicio" active="inicio" session={session}>
  <div class="panel-card">
    <h2>GPSITO</h2>
    <div id="homeGabotSlot"></div>
  </div>

  <div class="panel-card">
    <h2>Tus pendientes</h2>
    <div id="homePendientes" class="list-col">
      <div class="empty">Cargando...</div>
    </div>
  </div>
</InternoLayout>

<script src="/js/interno-home.js" defer></script>

