---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, findUserById, inventoryScopeFor, firstSectionFor, SECTION_PATHS } from '../../lib/auth';
import { getRedis } from '../../lib/redis';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);

const redis = getRedis();
const user = redis ? await findUserById(redis, session.userId) : null;
const scope = inventoryScopeFor(session, user);
if (!scope.length) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Inventario de sucursal" active="inventario" session={session}>
  <div id="inventarioData" data-scope={JSON.stringify(scope)} data-is-admin={session.role === 'admin' ? '1' : ''} style="display:none;"></div>

  <div class="panel-card">
    <div class="inv-head">
      <div>
        <h2>Inventario físico</h2>
        <p class="hint" style="margin:4px 0 0;">
          Equipos y SIM que hay físicamente en la sucursal. Debe quedar al día cada día: si no hubo cambios, confirma la revisión para que quede la fecha.
        </p>
      </div>
      <div class="filters inv-filters" style="margin:0;">
        <input id="invSearch" type="search" placeholder="Buscar IMEI, serial, SIM, modelo…" autocomplete="off" />
        <select id="branchSelect"></select>
        <button class="btn-small" id="exportBtn" type="button">Exportar CSV</button>
      </div>
    </div>
    <div class="inv-status" id="invStatus"></div>
    <div class="stats-row inv-stats" id="invStats"></div>
  </div>

  <div id="invSections"></div>
</InternoLayout>

<style is:global>
  .inv-head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: flex-start; }
  .inv-filters { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .inv-filters #invSearch { min-width: 260px; padding: 7px 10px; font-size: 13.5px; }
  .inv-table mark { background: var(--amber); color: var(--ink-900, #111); border-radius: 3px; padding: 0 2px; }
  .inv-search-note { color: var(--paper-dim); font-size: 13px; margin: 10px 0 0; }
  .inv-search-note b { color: var(--paper); }
  @media (max-width: 720px) { .inv-filters #invSearch { min-width: 0; width: 100%; } }
  .inv-status { display: flex; flex-direction: column; gap: 10px; margin: 14px 0 10px; font-size: 13.5px; }
  .inv-block { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; background: var(--ink-800); }
  .inv-block-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .inv-badge { display: inline-block; padding: 4px 10px; border-radius: 999px; font-size: 12.5px; font-weight: 600; }
  .inv-badge.ok { background: rgba(34, 197, 94, 0.18); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.5); }
  .inv-badge.bad { background: rgba(239, 68, 68, 0.18); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.5); }
  .inv-badge.none { background: transparent; color: var(--slate); border: 1px dashed var(--line); font-weight: 400; }
  .inv-diff { list-style: none; padding: 0; margin: 0 0 10px; font-size: 13px; }
  .inv-diff li { display: flex; justify-content: space-between; gap: 10px; padding: 4px 0; border-bottom: 1px dashed var(--line); }
  .inv-diff li.ok span:last-child { color: #22c55e; }
  .inv-diff li.bad span:last-child { color: #ef4444; font-weight: 600; }
  .inv-count { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; align-items: end; }
  .inv-count label { display: flex; flex-direction: column; gap: 4px; font-size: 12.5px; color: var(--paper-dim); }
  .inv-count label small { color: var(--slate); }
  .inv-count input { padding: 7px 9px; font-size: 14px; }
  .inv-audit-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .inv-audit-form input { flex: 1; min-width: 220px; padding: 7px 9px; font-size: 13px; }
  .inv-audit-note { color: var(--paper-dim); font-size: 13px; margin: 0 0 8px; }
  .inv-status .stamp { color: var(--paper-dim); }
  .inv-status .stamp.stale { color: var(--danger); font-weight: 600; }
  .inv-status .stamp.fresh { color: var(--ok); }
  .inv-stats { grid-template-columns: repeat(4, 1fr); }
  .inv-section { margin-top: 16px; }
  .inv-section h3 { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: 15px; margin-bottom: 10px; }
  .inv-section h3 .count { color: var(--slate); font-size: 12.5px; font-weight: 400; }
  .inv-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .inv-table th, .inv-table td { padding: 7px 8px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
  .inv-table th { color: var(--slate); font-size: 12px; font-weight: 600; white-space: nowrap; }
  .inv-table td input { width: 100%; min-width: 90px; padding: 6px 8px; font-size: 13px; }
  .inv-table td.actions { white-space: nowrap; text-align: right; }
  /* El estilo global pone los <select> a ancho completo: en la celda de acciones eso estiraba
     la tabla y aparecía una barra horizontal. */
  .inv-table td.actions select { width: auto; max-width: 180px; display: inline-block; padding: 5px 6px; font-size: 12.5px; margin-right: 4px; vertical-align: middle; }
  .inv-table td.actions .btn-small { vertical-align: middle; }
  .inv-table tr.new-row td { background: var(--glow-1); }
  .inv-table .who { color: var(--slate); font-size: 11.5px; white-space: nowrap; }
  @media (max-width: 720px) {
    .inv-stats { grid-template-columns: repeat(2, 1fr); }
    .inv-table th.who, .inv-table td.who { display: none; }
  }
</style>

<script src="/js/interno-inventario.js" defer></script>
