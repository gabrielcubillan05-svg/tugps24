---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canManageUsers, canSetUserBranches, firstSectionFor, SECTION_PATHS, ROLES, ROLE_LABELS, BRANCHES } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
const isFullAdmin = canManageUsers(session.role);
if (!isFullAdmin && !canSetUserBranches(session)) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Usuarios" active="usuarios" session={session}>
  {(isFullAdmin || canSetUserBranches(session)) && (
  <div class="panel-card">
    <h2>Nuevo usuario</h2>
    <form id="userForm">
      <div class="form-grid">
        <div class="field">
          <label for="u-username">Usuario (para iniciar sesión)</label>
          <input id="u-username" type="text" placeholder="ej: juanperez" required />
        </div>
        <div class="field">
          <label for="u-name">Nombre completo</label>
          <input id="u-name" type="text" placeholder="Ej: Juan Pérez" required />
        </div>
        <div class="field">
          <label for="u-role">Rol</label>
          <select id="u-role" required>
            {ROLES.filter((r) => isFullAdmin || r !== 'admin').map((r) => <option value={r}>{ROLE_LABELS[r]}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="u-password">Contraseña inicial (mín. 8 caracteres)</label>
          <input id="u-password" type="text" placeholder="Ej: TuGps2026" required />
        </div>
        <div class="field">
          <label for="u-branch">Sucursales (para secretaria/gerente — puedes elegir varias con Ctrl/Cmd)</label>
          <select id="u-branch" multiple size="4">
            {BRANCHES.map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="u-inventory">Encargado del inventario físico en (opcional, varias con Ctrl/Cmd)</label>
          <select id="u-inventory" multiple size="4">
            {BRANCHES.filter((b) => b !== 'Central de Monitoreo').map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>
      </div>
      <button class="btn" type="submit">Crear usuario</button>
      <p id="userFormError" class="error-msg" style="display:none; margin-top:12px;"></p>
    </form>
  </div>
  )}

  {isFullAdmin && (
  <div class="panel-card">
    <h2>Encargados de inventario</h2>
    <p style="color:var(--slate); font-size:13px; margin-bottom:14px;">
      Marca como encargados del inventario físico a los responsables de la lista de gerencia (Cristian Zambrano, Josué González, Gabriel Cubillán,
      Juan Plata, Arle Moguea, Mónica Cubillán, José Miguel Reales, Junior Cárdenas, Pierangela Sánchez, Kelly Lara y Alejandra Molina),
      usando la sucursal que cada uno tiene en su perfil. Cristian Zambrano lleva el inventario nacional y queda con todas las sucursales.
      Quien no tenga sucursal queda listado para asignarlo a mano con el selector "Inventario en".
    </p>
    <button class="btn-ghost" id="inventoryManagersBtn" type="button">Asignar encargados de inventario</button>
    <p id="inventoryManagersResult" style="display:none; margin-top:12px; font-size:13.5px; color:var(--paper-dim);"></p>
  </div>
  )}

  {isFullAdmin && (
  <div class="panel-card">
    <h2>Sucursal de los operadores</h2>
    <p style="color:var(--slate); font-size:13px; margin-bottom:14px;">
      Asigna la sucursal <b>Central de Monitoreo</b> a todos los usuarios con rol Operador (reemplaza la(s) sucursal(es) que tengan hoy).
    </p>
    <button class="btn-ghost" id="branchOperadoresBtn" type="button">Asignar Central de Monitoreo a los operadores</button>
    <p id="branchOperadoresResult" style="display:none; margin-top:12px; font-size:13.5px; color:var(--paper-dim);"></p>
  </div>
  )}

  <div class="panel-card">
    <h2>Usuarios</h2>
    {!isFullAdmin && <p class="hint">Puedes crear usuarios nuevos (sin rol de administrador) y asignarles sucursal y sucursal de inventario. Cambiar el rol, restablecer la contraseña o desactivar una cuenta lo hace el administrador.</p>}
    <div class="filters">
      <input id="searchInput" type="text" placeholder="Buscar por nombre o usuario..." />
      <select id="roleFilter">
        <option value="">Todos los roles</option>
        {ROLES.map((r) => <option value={r}>{ROLE_LABELS[r]}</option>)}
      </select>
    </div>
    <div class="list-col" id="usersList" data-full-admin={isFullAdmin ? '1' : ''}>
      <div class="empty">Cargando...</div>
    </div>
  </div>
</InternoLayout>

<style>
  .user-item {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }
  .user-item.inactive { opacity: 0.55; }
  .user-top { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; align-items: center; }
  .user-name { font-weight: 700; }
  .user-meta { color: var(--slate); font-size: 12.5px; margin-bottom: 8px; }
  .user-controls { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .user-controls select, .user-controls input { width: auto; padding: 7px 9px; font-size: 12.5px; }
</style>

<script src="/js/interno-usuarios.js" defer></script>
