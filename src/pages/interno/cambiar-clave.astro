---
export const prerender = false;

import { SESSION_COOKIE, LOGIN_PATH, getSession } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Cambiar contraseña — TuGPS24</title>
    <script src="/js/theme-toggle.js" is:inline></script>
    <style>
      :root {
        --ink-900: #0a0a0a;
        --ink-800: #151412;
        --line: #332e28;
        --paper: #f2ede2;
        --paper-dim: #c9c2b2;
        --slate: #948d80;
        --amber: #ff7a1a;
        --danger: #e0563f;
        --ok: #6fce8f;
      }
      html[data-theme="light"] {
        --ink-900: #faf7f2;
        --ink-800: #ffffff;
        --line: #e4dccb;
        --paper: #1c1712;
        --paper-dim: #5b5347;
        --slate: #8a8072;
        --amber: #e8630a;
        --danger: #c9432e;
        --ok: #2f8a4f;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--ink-900);
        color: var(--paper);
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        min-height: 100vh;
        line-height: 1.5;
      }
      .wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
      .box {
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 36px;
        width: 100%;
        max-width: 380px;
      }
      .box h1 { font-size: 20px; margin-bottom: 8px; }
      .box p { color: var(--slate); font-size: 13.5px; margin-bottom: 20px; }
      .field { margin-bottom: 16px; }
      .field label { display: block; color: var(--slate); font-size: 12.5px; margin-bottom: 6px; }
      input, button { font-family: inherit; font-size: 14.5px; }
      input {
        width: 100%;
        background: var(--ink-900);
        border: 1px solid var(--line);
        color: var(--paper);
        border-radius: 8px;
        padding: 10px 12px;
      }
      .btn {
        background: var(--amber);
        color: #1a0f00;
        border: none;
        cursor: pointer;
        border-radius: 999px;
        padding: 12px 20px;
        font-weight: 600;
        width: 100%;
      }
      .msg { font-size: 13px; margin-bottom: 14px; display: none; }
      .msg.error { color: var(--danger); }
      .msg.success { color: var(--ok); }
    </style>
  </head>
  <body data-user-id={session.userId}>
    <div class="wrap">
      <div class="box">
        <h1>Actualiza tu contraseña</h1>
        <p>Por seguridad debes elegir una contraseña nueva antes de continuar.</p>
        <p id="msgError" class="msg error"></p>
        <p id="msgSuccess" class="msg success">Contraseña actualizada. Iniciando sesión de nuevo…</p>
        <form id="changeForm">
          <div class="field">
            <label for="current">Contraseña actual</label>
            <input id="current" type="password" required autocomplete="current-password" />
          </div>
          <div class="field">
            <label for="fresh">Contraseña nueva (mínimo 8 caracteres)</label>
            <input id="fresh" type="password" required minlength="8" autocomplete="new-password" />
          </div>
          <button class="btn" type="submit" id="submitBtn">Guardar y continuar</button>
        </form>
      </div>
    </div>
    <script src="/js/interno-cambiar-clave.js" defer></script>
  </body>
</html>
