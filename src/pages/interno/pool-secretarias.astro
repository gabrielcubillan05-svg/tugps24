---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'pool-secretarias')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Pool de secretarias" active="pool-secretarias" session={session}>
  <div class="panel-card">
    <div class="pool-head">
      <div>
        <h2>Pool de secretarias</h2>
        <p class="hint" style="margin:4px 0 0;">Trabajo registrado por cada secretaria y gerente, contado desde la auditoría del panel: notas y cambios en el CRM, contactados y recordatorios de cobranza, suspensiones, solicitudes, tareas, cotizaciones y comprobantes. Lo que no se registra en el panel (una llamada sin nota) no aparece aquí. Hora de Colombia. Se actualiza solo cada minuto.</p>
      </div>
    </div>
    <div class="pool-filters">
      <div class="period-buttons">
        <button class="btn-small active" data-period="hoy" type="button">Hoy</button>
        <button class="btn-small" data-period="ayer" type="button">Ayer</button>
        <button class="btn-small" data-period="semana" type="button">Esta semana</button>
        <button class="btn-small" data-period="mes" type="button">Este mes</button>
        <button class="btn-small" data-period="custom" type="button">Personalizado</button>
      </div>
      <div class="period-custom-range" id="poolCustomRange" hidden>
        <label>Desde <input id="poolFrom" type="date" /></label>
        <label>Hasta <input id="poolTo" type="date" /></label>
        <button class="btn-small" id="poolCustomBtn" type="button">Consultar</button>
      </div>
      <select id="poolBranch"><option value="">Todas las sucursales</option></select>
      <select id="poolScope">
        <option value="secretarias">Secretarias y gerentes</option>
        <option value="todos">Todos los usuarios</option>
      </select>
      <span class="pool-updated" id="poolUpdated"></span>
    </div>
    <div class="table-scroll">
      <table class="stats-table pool-table" id="poolTable"><tbody><tr><td>Cargando...</td></tr></tbody></table>
    </div>
    <p class="hint" style="margin-top:8px;">Haz clic en una persona para ver su detalle día por día.</p>
  </div>

  <div class="panel-card" id="poolDetailCard" hidden>
    <h2 id="poolDetailTitle"></h2>
    <div class="table-scroll">
      <table class="stats-table pool-table" id="poolDetailTable"></table>
    </div>
  </div>
</InternoLayout>

<style>
  .pool-head { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .pool-filters { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 14px 0 12px; }
  .pool-filters select { width: auto; min-width: 180px; }
  .period-buttons { display: flex; gap: 6px; flex-wrap: wrap; }
  .period-buttons .btn-small.active { background: var(--amber); border-color: var(--amber); color: var(--ink-900); }
  .period-custom-range { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .period-custom-range label { display: flex; gap: 6px; align-items: center; font-size: 13px; color: var(--paper-dim); }
  .period-custom-range input { width: auto; }
  .pool-updated { color: var(--slate); font-size: 12.5px; margin-left: auto; }
  .pool-table { font-size: 13px; }
  .pool-table th { white-space: nowrap; font-size: 11.5px; }
  .pool-table th.group { text-align: center; color: var(--paper-dim); border-bottom: none; padding-bottom: 2px; }
  .pool-table td.num, .pool-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .pool-table td.zero { color: var(--slate); }
  .pool-table td.total { font-weight: 700; color: var(--amber); }
  .pool-table tr.person { cursor: pointer; }
  .pool-table tr.person:hover td { background: var(--glow-1); }
  .pool-table tr.person.selected td { background: var(--glow-1); }
  .pool-table .who { white-space: nowrap; }
  .pool-table .who small { display: block; color: var(--slate); font-size: 11px; }
  .pool-table .idle { color: var(--danger); }
  .pool-table .recent { color: var(--ok); }
  .pool-table tr.sum td { font-weight: 700; border-top: 2px solid var(--line); }
</style>

<script src="/js/interno-pool-secretarias.js" defer></script>
