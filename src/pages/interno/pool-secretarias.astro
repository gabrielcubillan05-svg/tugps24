---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'pool-secretarias')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}
---

<InternoLayout title="Pool de secretarias" active="pool-secretarias" session={session}>
  <div class="panel-card pool-card">
    <div class="pool-head">
      <div>
        <h2>Pool de secretarias</h2>
        <p class="pool-sub">Trabajo registrado en el panel por cada secretaria y gerente. Lo que no queda registrado (una llamada sin nota) no aparece. Se actualiza solo cada minuto.</p>
      </div>
      <span class="pool-updated" id="poolUpdated"></span>
    </div>

    <div class="pool-filters">
      <div class="period-buttons" role="tablist">
        <button class="seg active" data-period="hoy" type="button">Hoy</button>
        <button class="seg" data-period="ayer" type="button">Ayer</button>
        <button class="seg" data-period="semana" type="button">Esta semana</button>
        <button class="seg" data-period="mes" type="button">Este mes</button>
        <button class="seg" data-period="custom" type="button">Personalizado</button>
      </div>
      <div class="period-custom-range" id="poolCustomRange" hidden>
        <label>Desde <input id="poolFrom" type="date" /></label>
        <label>Hasta <input id="poolTo" type="date" /></label>
        <button class="btn-small" id="poolCustomBtn" type="button">Consultar</button>
      </div>
      <select id="poolBranch"><option value="">Todas las sucursales</option></select>
      <select id="poolScope">
        <option value="secretarias">Secretarias y gerentes</option>
        <option value="todos">Todos los usuarios</option>
      </select>
      <label class="pool-toggle"><input type="checkbox" id="poolShowEmpty" /> Columnas sin datos</label>
    </div>

    <div class="kpis" id="poolKpis"></div>

    <div class="table-scroll pool-scroll">
      <table class="pool-table" id="poolTable"><tbody><tr><td class="pool-loading">Cargando...</td></tr></tbody></table>
    </div>
    <p class="pool-foot">Efectividad = instalados ÷ agendados en el período. Haz clic en un encabezado para ordenar y en una persona para ver su detalle día por día.</p>
  </div>

  <div class="panel-card pool-card" id="poolDetailCard" hidden>
    <h2 id="poolDetailTitle"></h2>
    <div class="table-scroll pool-scroll">
      <table class="pool-table" id="poolDetailTable"></table>
    </div>
  </div>
</InternoLayout>

<style is:global>
  .pool-card h2 { font-size: 18px; margin-bottom: 4px; }
  .pool-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .pool-sub { margin: 0; color: var(--slate); font-size: 13px; max-width: 720px; line-height: 1.5; }
  .pool-updated { color: var(--slate); font-size: 12px; padding: 5px 10px; border: 1px solid var(--line); border-radius: 999px; white-space: nowrap; }

  .pool-filters { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 18px 0 16px; }
  .pool-filters select { width: auto; min-width: 180px; }
  .period-buttons { display: inline-flex; background: var(--ink-700); border: 1px solid var(--line); border-radius: 999px; padding: 3px; gap: 2px; flex-wrap: wrap; }
  .period-buttons .seg { background: transparent; border: 0; color: var(--paper-dim); font: inherit; font-size: 12.5px; padding: 6px 14px; border-radius: 999px; cursor: pointer; }
  .period-buttons .seg:hover { color: var(--paper); }
  .period-buttons .seg.active { background: var(--amber); color: #fff; font-weight: 600; }
  .period-custom-range { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .period-custom-range[hidden] { display: none; }
  .period-custom-range label { display: flex; gap: 6px; align-items: center; font-size: 13px; color: var(--paper-dim); }
  .period-custom-range input { width: auto; }
  .pool-toggle { display: inline-flex; gap: 6px; align-items: center; font-size: 12.5px; color: var(--slate); cursor: pointer; }
  .pool-toggle input { width: auto; margin: 0; }

  .kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
  .kpi { background: var(--ink-700); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
  .kpi .k-label { font-size: 11.5px; color: var(--slate); text-transform: uppercase; letter-spacing: .04em; }
  .kpi .k-value { font-size: 26px; font-weight: 700; margin-top: 4px; font-variant-numeric: tabular-nums; color: var(--paper); }
  .kpi .k-note { font-size: 12px; color: var(--paper-dim); margin-top: 2px; }
  .kpi.accent { border-color: var(--ring-1); background: linear-gradient(135deg, var(--glow-1), transparent 70%), var(--ink-700); }
  .kpi.accent .k-value { color: var(--amber); }
  @media (max-width: 900px) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .pool-scroll { border: 1px solid var(--line); border-radius: 12px; max-height: 70vh; overflow: auto; }
  .pool-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; }
  .pool-table th, .pool-table td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  .pool-table thead th { position: sticky; background: var(--ink-800); z-index: 2; font-size: 11.5px; font-weight: 600; color: var(--paper-dim); white-space: nowrap; }
  .pool-table thead tr.groups th { top: 0; height: 30px; padding-top: 8px; padding-bottom: 4px; }
  .pool-table thead tr.cols th { top: 30px; }
  .pool-table th.group { text-align: center; text-transform: uppercase; letter-spacing: .06em; font-size: 10.5px; color: var(--slate); border-bottom: 2px solid var(--amber); }
  .pool-table th.group.g-cobranza { border-bottom-color: var(--teal); }
  .pool-table th.group.g-otros { border-bottom-color: var(--slate); }
  .pool-table th.sortable { cursor: pointer; user-select: none; }
  .pool-table th.sortable:hover { color: var(--paper); }
  .pool-table th.sorted { color: var(--amber); }
  .pool-table th.num, .pool-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .pool-table td.num.zero { color: var(--slate); opacity: .55; }
  .pool-table th:first-child, .pool-table td:first-child { position: sticky; left: 0; background: var(--ink-800); z-index: 1; }
  .pool-table thead th:first-child { z-index: 3; }
  .pool-table tbody tr.person { cursor: pointer; }
  .pool-table tbody tr.person:hover td, .pool-table tbody tr.person.selected td { background-color: var(--ink-700); }
  .pool-table tbody tr.person.selected td:first-child { box-shadow: inset 3px 0 0 var(--amber); }

  .who { display: flex; align-items: center; gap: 10px; min-width: 220px; }
  .rank { width: 20px; text-align: center; font-size: 12px; color: var(--slate); font-variant-numeric: tabular-nums; }
  .avatar { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-size: 12.5px; font-weight: 700; color: #fff; flex: none; }
  .who-name { font-weight: 600; color: var(--paper); line-height: 1.25; }
  .who-meta { display: flex; gap: 6px; align-items: center; margin-top: 3px; flex-wrap: wrap; }
  .chip { font-size: 10.5px; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line); color: var(--paper-dim); white-space: nowrap; }
  .chip.gerente { border-color: var(--ring-1); color: var(--amber); }
  .branch { font-size: 11px; color: var(--slate); }

  .eff { display: flex; align-items: center; gap: 8px; justify-content: flex-end; min-width: 110px; }
  .eff-bar { width: 56px; height: 6px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .eff-bar span { display: block; height: 100%; border-radius: 999px; }
  .eff-val { font-weight: 600; min-width: 38px; text-align: right; }
  .eff-na { color: var(--slate); opacity: .55; }

  .pool-table td.total { font-weight: 700; color: var(--amber); font-size: 14px; }
  .last { display: flex; gap: 8px; align-items: flex-start; white-space: nowrap; }
  .dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 5px; flex: none; background: var(--slate); }
  .dot.recent { background: var(--ok); box-shadow: 0 0 0 3px #6fce8f33; }
  .dot.idle { background: var(--danger); }
  .last small { display: block; color: var(--slate); font-size: 11px; }
  .pool-table tr.sum td { font-weight: 700; border-top: 2px solid var(--line); background: var(--ink-700); position: sticky; bottom: 0; }
  .pool-table tr.sum td:first-child { z-index: 2; }
  .pool-loading { color: var(--slate); padding: 24px; }
  .pool-foot { margin-top: 10px; font-size: 12px; color: var(--slate); }
</style>

<script src="/js/interno-pool-secretarias.js" defer></script>
