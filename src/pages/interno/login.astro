---
export const prerender = false;

import { SESSION_COOKIE, getSession, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (session) {
  const section = firstSectionFor(session.role);
  return Astro.redirect(section ? SECTION_PATHS[section] : '/interno/login');
}

const errorParam = Astro.url.searchParams.get('error');
const loginError = errorParam === '1';
const lockedOut = errorParam === 'locked';
---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Acceso interno — TuGPS24</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="/js/theme-toggle.js" is:inline></script>
    <style>
      :root {
        --ink-900: #0a0a0a;
        --ink-800: #151412;
        --line: #332e28;
        --paper: #f2ede2;
        --paper-dim: #c9c2b2;
        --slate: #948d80;
        --amber: #ff7a1a;
        --danger: #e0563f;
        --glow-1: #ff7a1a29;
        --shadow-soft: #00000059;
        --btn-shadow: #ff7a1a73;
        --body: "Poppins", system-ui, sans-serif;
      }
      html[data-theme="light"] {
        --ink-900: #faf7f2;
        --ink-800: #ffffff;
        --line: #e4dccb;
        --paper: #1c1712;
        --paper-dim: #5b5347;
        --slate: #8a8072;
        --amber: #e8630a;
        --danger: #c9432e;
        --glow-1: #e8630a1a;
        --shadow-soft: #1e140a14;
        --btn-shadow: #e8630a4d;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--ink-900);
        color: var(--paper);
        font-family: var(--body);
        min-height: 100vh;
        line-height: 1.5;
      }
      .login-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
      .login-box {
        background: var(--ink-800);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 36px;
        width: 100%;
        max-width: 360px;
        box-shadow: 0 1px 2px var(--shadow-soft), 0 10px 26px -14px var(--shadow-soft);
      }
      .login-box h1 { font-size: 20px; margin-bottom: 8px; }
      .login-box p { color: var(--slate); font-size: 13.5px; margin-bottom: 20px; }
      .field { margin-bottom: 16px; }
      .field label { display: block; color: var(--slate); font-size: 12.5px; margin-bottom: 6px; }
      input, button { font-family: inherit; font-size: 14.5px; }
      input {
        width: 100%;
        background: var(--ink-900);
        border: 1px solid var(--line);
        color: var(--paper);
        border-radius: 8px;
        padding: 10px 12px;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      input:focus { outline: none; border-color: var(--amber); box-shadow: 0 0 0 3px var(--glow-1); }
      .btn {
        background: var(--amber);
        color: #1a0f00;
        border: none;
        cursor: pointer;
        border-radius: 999px;
        padding: 12px 20px;
        font-weight: 600;
        width: 100%;
        box-shadow: 0 4px 14px var(--btn-shadow);
        transition: transform 0.15s, box-shadow 0.15s;
      }
      .btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px var(--btn-shadow); }
      .error-msg { color: var(--danger); font-size: 13px; margin-bottom: 14px; }
    </style>
  </head>
  <body>
    <div class="login-wrap">
      <div class="login-box">
        <h1>Acceso interno</h1>
        <p>Solo para personal de TuGPS24.</p>
        {loginError && <p class="error-msg">Usuario o contraseña incorrectos.</p>}
        {lockedOut && <p class="error-msg">Demasiados intentos fallidos. Espera unos minutos e intenta de nuevo.</p>}
        <form method="POST" action="/api/auth/login">
          <div class="field">
            <label for="username">Usuario</label>
            <input id="username" name="username" type="text" required autofocus autocomplete="username" />
          </div>
          <div class="field">
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" />
          </div>
          <button class="btn" type="submit">Entrar</button>
        </form>
      </div>
    </div>
  </body>
</html>
