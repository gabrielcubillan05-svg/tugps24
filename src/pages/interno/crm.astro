---
export const prerender = false;

import InternoLayout from '../../layouts/InternoLayout.astro';
import { SESSION_COOKIE, LOGIN_PATH, CHANGE_PASSWORD_PATH, getSession, canAccessSection, canVerifyInstalls, canManageMediaAssets, firstSectionFor, SECTION_PATHS } from '../../lib/auth';

const session = await getSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (!session) return Astro.redirect(LOGIN_PATH);
if (session.mustChangePassword) return Astro.redirect(CHANGE_PASSWORD_PATH);
if (!canAccessSection(session.role, 'crm')) {
  const fallback = firstSectionFor(session.role);
  return Astro.redirect(fallback ? SECTION_PATHS[fallback] : LOGIN_PATH);
}

const STATUSES = ['Nuevo', 'Contactado', 'Cotizado', 'Agendado', 'Instalado', 'Perdido'];
const BRANCHES = ['Riohacha', 'Valledupar', 'Santa Marta', 'Maicao', 'Atlántico', 'Bucaramanga', 'Medellín', 'Montería'];
---

<InternoLayout title="CRM" active="crm" session={session}>
  <div id="crmData" data-statuses={JSON.stringify(STATUSES)} data-branches={JSON.stringify(BRANCHES)} data-can-manage-media={canManageMediaAssets(session.role) ? '1' : ''} data-can-set-status={canVerifyInstalls(session.role) ? '1' : ''} style="display:none;"></div>

  <div class="stats-row" id="statsRow"></div>
  <br />

  <div class="panel-card">
    <h2>Nuevo lead</h2>
    <form id="leadForm">
      <div class="form-grid">
        <div class="field">
          <label for="name">Nombre</label>
          <input id="name" type="text" placeholder="Nombre del interesado (opcional si aún no lo sabes)" />
        </div>
        <div class="field">
          <label for="phone">Teléfono o usuario de WhatsApp</label>
          <input id="phone" type="text" placeholder="+57 300 000 0000 o @usuario" required />
        </div>
        <div class="field">
          <label for="city">Ciudad</label>
          <select id="city">
            <option value="">Selecciona una ciudad</option>
            {BRANCHES.map((b) => <option value={b}>{b}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="campaign">Campaña / anuncio de origen</label>
          <input id="campaign" type="text" placeholder="Ej: Facebook - Promo aniversario" />
        </div>
        <div class="field">
          <label for="secretary">Secretaria / Gerente asignado</label>
          <select id="secretary">
            <option value="">Sin asignar</option>
          </select>
        </div>
        <div class="field">
          <label for="nextFollowUp">Próximo seguimiento</label>
          <input id="nextFollowUp" type="date" />
        </div>
        <div class="field">
          <label for="vehicleType">Tipo de cliente</label>
          <select id="vehicleType">
            <option value="">Sin definir</option>
            <option value="Moto">Moto</option>
            <option value="Carro">Carro</option>
            <option value="Flota">Flota</option>
          </select>
        </div>
        <div class="field">
          <label for="motosCount">Cantidad de motos</label>
          <input id="motosCount" type="number" min="0" placeholder="0" />
        </div>
        <div class="field">
          <label for="carrosCount">Cantidad de carros</label>
          <input id="carrosCount" type="number" min="0" placeholder="0" />
        </div>
        <div class="field field-full">
          <label for="initialNote">Nota inicial (opcional)</label>
          <textarea id="initialNote" placeholder="Detalle del primer contacto"></textarea>
        </div>
      </div>
      <button class="btn" type="submit">Guardar lead</button>
    </form>
  </div>

  {canVerifyInstalls(session.role) && (
    <div class="panel-card">
      <h2>Verificar instalaciones</h2>
      <p class="hint">Sube el Excel con las órdenes de instalación reales (debe tener una columna de teléfono/celular). Se compara contra los leads del CRM para confirmar cuáles se instalaron de verdad, sin depender de lo que marque el operador.</p>
      <form id="verifyInstallsForm" class="verify-installs-form">
        <input id="verifyInstallsFile" type="file" accept=".xlsx,.xls,.csv" required />
        <button class="btn-small" type="submit">Comparar y verificar</button>
      </form>
      <div id="verifyInstallsResult"></div>
    </div>
  )}

  {session.role === 'admin' && (
    <div class="panel-card">
      <h2>Recursos para WhatsApp</h2>
      <p class="hint">Fotos y videos para acompañar los mensajes a los clientes. Copia el enlace o descarga la imagen y adjúntala manualmente en WhatsApp (WhatsApp no permite adjuntar archivos automáticamente desde un enlace).</p>
      {canManageMediaAssets(session.role) && (
        <div class="media-upload-forms">
          <form id="mediaImageForm" class="media-form">
            <input id="mediaImageLabel" type="text" placeholder="Nombre (ej: Promoción aniversario)" required />
            <input id="mediaImageFile" type="file" accept="image/*" required />
            <button class="btn-small" type="submit">Subir foto</button>
          </form>
          <form id="mediaLinkForm" class="media-form">
            <input id="mediaLinkLabel" type="text" placeholder="Nombre (ej: Video explicativo)" required />
            <input id="mediaLinkUrl" type="url" placeholder="Enlace (Drive, YouTube, etc.)" required />
            <button class="btn-small" type="submit">Agregar enlace de video</button>
          </form>
          <p class="hint">Para videos: súbelo a Drive o YouTube (puede ser "no listado") y pega aquí el enlace — los archivos de video pesan demasiado para subirlos directo.</p>
        </div>
      )}
      <div id="mediaGallery" class="media-gallery"></div>
    </div>
  )}

  {canVerifyInstalls(session.role) && (
    <div class="panel-card">
      <h2>Resultados</h2>
      <p class="hint">Conversión real por campaña (usando instalaciones verificadas, no lo autoreportado) y tiempo de respuesta por secretaria.</p>
      <div id="resultsPanel"></div>
    </div>
  )}

  <div class="panel-card">
    <h2>Buscar y filtrar</h2>
    <div class="filters">
      <input id="searchInput" type="text" placeholder="Buscar por nombre, teléfono o campaña..." />
      <select id="cityFilter"><option value="">Todas las ciudades</option></select>
      <select id="secretaryFilter"><option value="">Todos (secretaria/gerente)</option></select>
      <select id="statusFilter">
        <option value="">Todos los estados</option>
        {STATUSES.map((s) => <option value={s}>{s}</option>)}
      </select>
      <select id="vehicleTypeFilter">
        <option value="">Todos los tipos</option>
        <option value="Moto">Moto</option>
        <option value="Carro">Carro</option>
        <option value="Flota">Flota</option>
      </select>
      <label class="checkbox"><input type="checkbox" id="overdueFilter" /> Solo atrasados</label>
      <button class="btn-ghost" type="button" id="exportBtn">Exportar CSV</button>
    </div>
    <div class="view-toggle">
      <button type="button" class="btn-small view-btn active" data-view="list">Lista</button>
      <button type="button" class="btn-small view-btn" data-view="board">Tablero</button>
    </div>
    <div class="leads-list" id="leadsList">
      <div class="empty">Cargando...</div>
    </div>
    <div class="leads-board" id="leadsBoard" style="display:none;"></div>
  </div>
</InternoLayout>

<style is:global>
  .leads-list { display: flex; flex-direction: column; gap: 12px; }
  .lead-item {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px;
  }
  .lead-item.overdue { border-color: var(--danger); background: #e0563f14; }
  .lead-top { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; align-items: center; }
  .lead-name { font-weight: 700; font-size: 15px; }
  .lead-meta { color: var(--slate); font-size: 12.5px; margin-bottom: 10px; }
  .lead-controls { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .lead-controls select, .lead-controls input { width: auto; padding: 7px 9px; font-size: 12.5px; }
  .lead-controls .date-field { display: flex; flex-direction: column; gap: 2px; }
  .lead-controls .date-field span { color: var(--slate); font-size: 10.5px; }
  .badge.Nuevo { background: #ffab5c33; color: var(--teal-bright); }
  .badge.Contactado { background: #4a90d922; color: #7ab8ec; }
  .badge.Cotizado { background: #ff7a1a29; color: var(--amber); }
  .badge.Agendado { background: #8a5cf622; color: #b79bfa; }
  .badge.Instalado { background: #2f8a4f33; color: var(--ok); }
  .badge.Perdido { background: #e0563f22; color: var(--danger); }
  .badge.overdue-badge { background: var(--danger); color: #fff; }
  .badge.badge-installed { background: #2f8a4f33; color: var(--ok); }
  .badge.badge-verified { background: #2f8a4f33; color: var(--ok); }
  .badge.badge-unverified { background: #ff7a1a29; color: var(--amber); }
  .badge.badge-cold { background: #e0563f22; color: var(--danger); }
  .badge.badge-meta { background: #4a90d922; color: #7ab8ec; }
  .hint { color: var(--slate); font-size: 12.5px; margin-bottom: 12px; }

  .view-toggle { display: flex; gap: 8px; margin-bottom: 14px; }
  .view-toggle .view-btn.active { background: var(--amber); color: #1a0f00; }

  .leads-board { overflow-x: auto; padding-bottom: 8px; }
  .board-columns { display: flex; gap: 12px; min-width: min-content; }
  .board-col {
    flex: 0 0 250px;
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px;
    display: flex;
    flex-direction: column;
  }
  .board-col-head { display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 13px; margin-bottom: 10px; }
  .board-col-head .board-count { color: var(--slate); font-weight: 500; font-size: 11.5px; }
  .board-col-body { display: flex; flex-direction: column; gap: 8px; min-height: 60px; border-radius: 8px; transition: background 0.15s; }
  .board-col-body.drag-over { background: #ff7a1a1f; }
  .board-empty { color: var(--slate); font-size: 12px; text-align: center; padding: 14px 0; }
  .board-card {
    background: var(--ink-700);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 10px;
    cursor: grab;
  }
  .board-card.dragging { opacity: 0.45; }
  .board-card.overdue { border-color: var(--danger); }
  .board-card-name { font-weight: 600; font-size: 13px; margin-bottom: 2px; }
  .board-card-meta { color: var(--slate); font-size: 11.5px; margin-bottom: 6px; }
  .board-card-badges { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
  .board-card-badges .badge { font-size: 10px; padding: 1px 7px; }
  .btn-tiny { display: inline-block; font-size: 11px; padding: 4px 9px; border-radius: 999px; }

  .results-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 900px) { .results-grid { grid-template-columns: 1fr; } }
  .results-grid h3 { font-size: 13.5px; margin-bottom: 8px; }
  .results-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .results-table th, .results-table td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: left; }
  .results-table th { color: var(--slate); font-weight: 600; font-size: 11.5px; }
  .wa-select { width: auto; padding: 7px 9px; font-size: 12.5px; }

  .media-upload-forms { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
  .media-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .media-form input[type="text"], .media-form input[type="url"] { flex: 1; min-width: 180px; }
  .media-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .media-item {
    background: var(--ink-800);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .media-thumb {
    width: 100%;
    height: 100px;
    border-radius: 8px;
    background: var(--ink-700);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 32px;
  }
  .media-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .media-label { font-size: 12.5px; font-weight: 600; }
  .media-actions { display: flex; gap: 6px; flex-wrap: wrap; }
  .verify-installs-form { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .verify-installs-form input[type="file"] { flex: 1; min-width: 200px; }
  #verifyInstallsResult { margin-top: 12px; font-size: 13px; }
  #verifyInstallsResult .result-ok { color: var(--ok); }
  #verifyInstallsResult .result-error { color: var(--danger); }
  #verifyInstallsResult .unmatched-list { color: var(--slate); font-size: 12px; margin-top: 6px; }
  .notes-list { border-top: 1px solid var(--line); margin-top: 10px; padding-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .notes-list .note-item { font-size: 12.5px; color: var(--paper-dim); }
  .notes-list .note-item .note-date { color: var(--slate); font-size: 11px; margin-right: 6px; }
  .add-note-row { display: flex; gap: 8px; margin-top: 10px; }
  .add-note-row input { flex: 1; }
</style>

<script src="/js/interno-crm.js" defer></script>
