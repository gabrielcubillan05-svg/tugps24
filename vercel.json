{
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/interno-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/interno/" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/whatsapp-followup-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/whatsapp-cold-followup-cron",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/whatsapp-cobros-bulk-cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/gabot-reminders-cron",
      "schedule": "50 12,15,18,21 * * *"
    }
  ]
}
